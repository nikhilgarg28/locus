### checked-indices
fn in_bounds(items: &[u32], wanted: &[usize]) -> Vec<(usize, Proof![i < items.len()])> {
    sk::holds1(|i: usize| {
        sk::lt(
            sk::model_of(&i),
            sk::model_of(&items).__logic_len(),
        )
    });
    let mut checked: Vec<(usize, Proof![i < items.len()])> = Vec::new();
    sk::holds1(|i: usize| {
        sk::lt(
            sk::model_of(&i),
            sk::model_of(&items).__logic_len(),
        )
    });
    for &i in wanted {
        if i < items.len() {
            checked.push((i, proof! ([] [] [])));
        }
    }
    checked
}
