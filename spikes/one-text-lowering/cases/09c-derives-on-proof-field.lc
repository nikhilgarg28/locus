// Hard case 9c: the same derives, and more, on a struct with a proof field.
#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
struct Witnessed {
    x: u32,
    ok: @(x > 0),
}

fn main() {
    let w = Witnessed { x: 1, ok: _ };
    let mut set = std::collections::HashSet::new();
    set.insert(w);
    println!("w == w: {}, set.len() = {}, {:?}", w == w, set.len(), w);
}
