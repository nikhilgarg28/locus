// Hard case 4d: litmus logical-layer/proof-function-to-unchecked.reject.lc.
fn halve(n: u32, even: @(n % 2 == 0)) -> u32 {
    n / 2
}

fn lend() -> u32 {
    let f = std::hint::black_box(halve); //~ error: Locus must reject; rustc cannot
    f(10, _)
}

fn main() {
    println!("lend() = {}", lend());
}
