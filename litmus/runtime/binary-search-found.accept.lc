//~ question: Is a binary search's found index proved in bounds and right, with no fact kept by the loop?
//~ spec: runtime.loops, runtime.operations.returned, runtime.arith.wrapping
//~ rfc: 0004

fn binary_search(xs: &[u32], target: u32) -> Option<(i: usize, @(i < xs.len() && xs[i] == target))> {
    let mut lo = 0;
    let mut hi = xs.len();
    while lo < hi {
        // `lo < hi` is the loop's condition, so the midpoint needs no proof.
        let mid = lo + (hi - lo) / 2;
        if xs[mid] < target {
            lo = mid + 1;
        } else if xs[mid] > target {
            hi = mid;
        } else {
            // The index returned, so `mid < xs.len()`; neither comparison held, so the element is `target`.
            return Some((mid, _));
        }
    }
    None
}

fn found() -> bool {
    binary_search(&[1, 3, 5, 7], 5).is_some()
}

fn missing() -> bool {
    binary_search(&[1, 3, 5, 7], 4).is_some()
}

//~ run: found() => true
//~ run: missing() => false
