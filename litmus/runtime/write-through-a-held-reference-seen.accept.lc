//~ question: After a write through a mutable reference that a struct holds, is the struct known to hold the new value, by the function and by its caller?
//~ spec: runtime.writes, runtime.borrows, contracts.final
//~ rfc: 0005

struct Holder<'a> {
    m: &'a mut u32,
}

fn poke(h: &mut Holder<'_>) -> @(final!(h).m == 2) {
    *h.m = 2;
    _
}

fn two() -> u32 {
    let mut a: u32 = 1;
    let mut h = Holder { m: &mut a };
    let poked = poke(&mut h);
    let now: @(h.m == 2) = _;
    *h.m
}

//~ run: two() => 2
