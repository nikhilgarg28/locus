//~ question: In an arm of a `match`, is it known that the earlier arms' patterns did not match?
//~ spec: runtime.patterns
//~ rfc: 0004

fn band(n: u32) -> (b: u32, @(b == 0 || n > 9)) {
    match n {
        0..=9 => (0, _),
        _ => (1, _),
    }
}

//~ run: band(4).0 => 0
//~ run: band(40).0 => 1
