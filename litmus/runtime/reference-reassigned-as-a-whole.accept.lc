//~ question: When a local variable that holds a mutable reference is assigned another, does the borrow it held end with its target's value there, and does the new one write its own target?
//~ spec: runtime.borrows, contracts.final
//~ rfc: 0005

fn both() -> (u32, u32) {
    let mut a: u32 = 1;
    let mut b: u32 = 2;
    let mut r = &mut a;
    *r = 3;
    r = &mut b;
    *r = 7;
    let known: @(a == 3 && b == 7) = _;
    (a, b)
}

//~ run: both().0 => 3
//~ run: both().1 => 7
