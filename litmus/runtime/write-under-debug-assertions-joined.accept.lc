//~ question: After a write that runs only under `cfg!(debug_assertions)`, is the variable known as one of its two values?
//~ spec: runtime.debug-assertions, runtime.joins
//~ rfc: 0004

fn reset(mut n: u32, small: @(n < 10)) -> (out: u32, @(out <= 50)) {
    if cfg!(debug_assertions) {
        n = 50;
    }
    (n, _)
}

// The value is 50 in a build with debug assertions and 3 in one without, so the
// run checks what both satisfy.
fn at_most_fifty() -> bool {
    reset(3, _).0 <= 50
}

//~ run: at_most_fifty() => true
