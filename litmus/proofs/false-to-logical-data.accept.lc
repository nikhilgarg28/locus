//~ question: Does logical never eliminate an impossible case into an arbitrary expected logical type?
//~ spec: proofs.elimination, logic.types.never
//~ rfc: 0002

pub logic fn unreachable(p: @False) -> ! { match p {} }

logic fn impossible_value<A: Logical>(p: @False) -> A {
    unreachable(p)
}

logic fn impossible_index(i: Nat, inside_empty: @(i < 0)) -> Nat {
    unreachable(prove!(False))
}
