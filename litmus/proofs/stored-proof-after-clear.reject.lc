//~ question: Does a proof stored in a vector still prove its proposition about a place that was written after the vector's type was written?
//~ spec: proofs.versions
//~ rfc: 0002

fn first(items: &mut Vec<u32>, nonempty: @(items.len() > 0)) -> u32 {
    let mut checked: Vec<(i: usize, @(i < items.len()))> = Vec::new();
    checked.push((0, _));
    items.clear();
    let (idx, inbounds) = checked[0];
    let still: @(idx < items.len()) = inbounds; //~ error: `inbounds` proves `idx < items.len()` about the version of `items` before `clear`, not the current one
    items[idx]
}
