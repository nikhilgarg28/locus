//~ question: Does a hole use a proof of a `forall` at a value that nobody wrote?
//~ spec: proofs.holes, proofs.procedures
//~ rfc: 0003

prop Even(n: Nat) {
    Zero => { n == 0 }
    Step(m: Nat) => { n == m + 2 && Even(m) }
}

logic fn at_three(doubles: @(forall |n: Nat| Even(2 * n))) -> @Even(2 * 3) {
    _ //~ error: cannot prove `Even(2 * 3)`: `doubles` proves a `forall`, which a hole does not use at a value; write `doubles(3)`
}
