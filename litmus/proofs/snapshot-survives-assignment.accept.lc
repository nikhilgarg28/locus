//~ question: Does a proof about a snapshot stay valid after the variable it came from is assigned?
//~ spec: proofs.snapshot
//~ rfc: 0002

fn snapshot() -> u8 {
    let mut n: u8 = 3;
    let before = logic! { n };
    let positive: @(before > 0) = _;
    n = 0;
    let still: @(before > 0) = positive;
    n
}

//~ run: snapshot() => 0
