//~ question: Does a separate lawful policy leave the logical operand type's == dispatch unchanged?
//~ spec: traits.equivalence, traits.operators, logic.eq.comparisons
//~ rfc: 0006

use locus::logic::{PartialEquiv, Equiv};

logic fn compare_both<K: PartialEquiv, E: Equiv<K>>(a: K, b: K) -> (Prop, Prop) {
    (a == b, <E as PartialEquiv<K>>::equiv(a, b))
}

logic fn own_relation<K: PartialEquiv, E: Equiv<K>>(a: K, b: K)
    -> @iff(a == b, <K as PartialEquiv<K>>::equiv(a, b)) {
    _
}
