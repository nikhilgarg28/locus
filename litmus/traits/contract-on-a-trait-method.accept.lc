//~ question: May a trait method return a proof, which code that is generic over the trait then uses?
//~ spec: traits.members, traits.impls.conform, traits.evidence
//~ rfc: 0006

trait OneByte {
    fn byte(&self) -> (b: u8, @(b < 128));
}

struct Letter(u8);

impl OneByte for Letter {
    fn byte(&self) -> (b: u8, @(b < 128)) {
        if small: self.0 < 128 { (self.0, small) } else { (0, _) }
    }
}

fn ascii(b: u8, small: @(b < 128)) -> u8 {
    b
}

fn first<P: OneByte>(p: &P) -> u8 {
    let (b, small) = p.byte();
    ascii(b, small)
}

//~ run: first(&Letter(65)) => 65
//~ run: first(&Letter(200)) => 0
