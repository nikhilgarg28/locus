//~ question: May a logic function of an implementation call generic code at the type it is implemented for?
//~ spec: traits.impls.acyclic
//~ rfc: 0006

trait Truth: Logical {
    logic fn holds() -> @False;
}

logic fn pull<T: Truth>() -> @False {
    T::holds()
}

impl Truth for Int {
    logic fn holds() -> @False {
        pull::<Int>() //~ error: the evidence for `Int: Truth` is used to define itself: `pull::<Int>` is given the implementation that `holds` belongs to
    }
}
