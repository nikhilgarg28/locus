//~ question: May Locus's `prove!` appear in the output of a program's own macro?
//~ spec: compat.names.direct-only
//~ rfc: 0001

macro_rules! reflexive {
    ($x:expr) => {
        prove!($x == $x) //~ error: Locus's `prove!` cannot be used in a macro's output
    };
}

fn same(x: u32) -> u32 {
    let proof = reflexive!(x);
    x
}
