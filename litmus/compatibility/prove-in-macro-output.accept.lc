//~ question: May Locus's `prove!` appear in the output of a program's own macro?
//~ spec: compat.names.macros-expand
//~ rfc: 0001

macro_rules! reflexive {
    ($x:expr) => {
        prove!($x == $x)
    };
}

fn same(x: u32) -> u32 {
    let proof: @(x == x) = reflexive!(x);
    x
}

//~ run: same(4) => 4
