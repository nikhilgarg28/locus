//~ question: Are tokens that look like Locus syntax left alone inside a macro's input?
//~ spec: compat.syntax.not-rust
//~ rfc: 0001

macro_rules! pair {
    ($a:ident @ $b:ident) => {
        ($a, $b)
    };
}

fn shown() -> &'static str {
    stringify!(@(x > 0))
}

fn joined(x: u32, y: u32) -> (u32, u32) {
    pair!(x @ y)
}

//~ run: shown() => "@(x > 0)"
//~ run: joined(1, 2) => (1, 2)
