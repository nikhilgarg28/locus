//~ question: Inside another macro's input, does `prove!` read the whole variable, so that a mutable borrow of another field conflicts?
//~ spec: observe.macro-expansions
//~ rfc: 0001

struct Pair {
    a: u32,
    b: u32,
}

fn bump_a(p: &mut Pair, positive: @(p.b > 0)) -> u32 {
    let a = &mut p.a;
    let still: Vec<@(p.b > 0)> = vec![prove!(p.b > 0)]; //~ error: inside `vec!`, `prove!` reads all of `p`, which is mutably borrowed through `a`
    *a += 1;
    p.b
}
