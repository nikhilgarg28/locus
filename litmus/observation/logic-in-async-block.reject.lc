//~ question: May logical code appear inside an async block?
//~ spec: observe.captures.rejected
//~ rfc: 0001

fn f() -> usize {
    let v = vec![1, 2, 3];
    let pending = async {
        let n = logic! { v.len() }; //~ error: logical code inside an async block is not supported
        v.len()
    };
    drop(pending);
    v.len()
}
