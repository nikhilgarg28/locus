//~ question: May a proof about a vector be restated after the vector has moved?
//~ spec: observe.place.readable
//~ rfc: 0001

fn consume(v: Vec<u32>) -> usize {
    v.len()
}

fn f(v: Vec<u32>, nonempty: @(v.len() > 0)) -> usize {
    let count = consume(v);
    let again: @(v.len() > 0) = nonempty; //~ error: logical code reads `v` after `v` was moved
    count
}
