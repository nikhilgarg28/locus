//~ question: May logical code read a vector before the vector is moved?
//~ spec: observe.place.readable, models.observation
//~ rfc: 0001

fn consume(v: Vec<u32>) -> usize {
    v.len()
}

fn f() -> usize {
    let v = vec![1, 2, 3];
    let n = logic! { v.len() };
    consume(v)
}

//~ run: f() => 3
