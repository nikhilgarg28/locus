//~ question: May logical code read a vector while it is mutably borrowed?
//~ spec: observe.place.readable
//~ rfc: 0001

fn f() -> usize {
    let mut v = vec![1, 2, 3];
    let r = &mut v;
    let n = @{ v.len() }; //~ error: logical code reads `v` while `v` is mutably borrowed
    r.push(4);
    v.len()
}
