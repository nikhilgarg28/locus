//~ question: May a proof about a vector be restated before the vector is moved?
//~ spec: observe.place.readable, proofs.versions
//~ rfc: 0001

fn consume(v: Vec<u32>) -> usize {
    v.len()
}

fn f(v: Vec<u32>, nonempty: @(v.len() > 0)) -> usize {
    let again: @(v.len() > 0) = nonempty;
    consume(v)
}
