//~ question: In an exported crate, may a function with a ghost parameter be used as a value, as it may when the crate is built?
//~ spec: export.function-values
//~ rfc: 0001
//~ mode: export

fn grow(n: u32, by: Nat) -> u32 {
    n + 1
}

pub fn count() -> u32 {
    let f = grow;
    let one = f(0, logic! { 1 });
    f(one, logic! { 2 })
}

//~ run: count() => 2
