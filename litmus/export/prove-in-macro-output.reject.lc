//~ question: May an exported crate use a macro of its own whose output invokes `prove!`?
//~ spec: export.macros-direct
//~ rfc: 0001
//~ mode: export

macro_rules! reflexive {
    ($x:expr) => {
        prove!($x == $x) //~ error: in an exported crate, Locus's `prove!` cannot be invoked in a macro's output, because erasure could not remove it
    };
}

pub fn same(x: u32) -> u32 {
    let proof: @(x == x) = reflexive!(x);
    x
}
