//~ question: May an exported crate's public struct have a `pub(locus)` field of logical type?
//~ spec: export.locus-visibility, export.invariants-closed
//~ rfc: 0002
//~ mode: export

pub struct Tally { //~ error: `Tally` is reachable from other crates, and its field `count` has a logical type, so it cannot be exported, whatever the field's visibility; declare the struct `pub(locus)`
    pub hits: u32,
    pub(locus) count: Nat,
}

impl Tally {
    pub fn new() -> Tally {
        Tally { hits: 0, count: logic! { 0 } }
    }
}
