//~ question: May an exported crate's public struct have a `pub(locus)` field of logical type?
//~ spec: export.locus-visibility, export.plain-interface
//~ rfc: 0002
//~ mode: export

pub struct Tally {
    pub hits: u32,
    pub(locus) count: Nat,
}

impl Tally {
    pub fn new() -> Tally {
        Tally { hits: 0, count: 0 }
    }
}
