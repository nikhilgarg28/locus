//~ question: In an exported crate, may a ghost local be named inside a function-like macro's input?
//~ spec: export.macros-direct
//~ rfc: 0001
//~ mode: export

macro_rules! one {
    ($e:expr) => {
        [$e]
    };
}

pub fn holders() -> usize {
    let h = prove!(1 == 1);
    let v: [@(1 == 1); 1] = one![h];
    v.len()
}

//~ run: holders() => 1
