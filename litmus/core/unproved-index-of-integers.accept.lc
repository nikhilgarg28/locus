//~ question: May a sequence of integers be indexed with no proof, so that a predicate over it reads plainly?
//~ spec: core.sequences.default, core.conversion
//~ rfc: 0005

logic fn sorted(xs: Seq<Int>) -> Prop {
    forall |i: Int, j: Int| 0 <= i && i <= j && j < xs.len() ==> xs[i] <= xs[j]
}

logic fn first_is_least(xs: Seq<Int>, ordered: @sorted(xs), k: Int, inside: @(0 <= k && k < xs.len())) -> @(xs[0] <= xs[k]) {
    ordered(0, k)(linear((inside,)))
}
