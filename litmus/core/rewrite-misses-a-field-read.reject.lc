//~ question: Does `rewrite` with an equality of models replace a value where a proof reads one of its fields?
//~ spec: proofs.equality, core.elaboration
//~ rfc: 0005

struct Inner {
    x: u32,
}

impl Model for Inner {
    type Logic = Nat;
    logic fn model(inner: &Inner) -> Nat {
        0
    }
}

#[derive(Model)]
struct Outer {
    inner: Inner,
}

logic fn x_of(o: &Outer) -> Nat {
    o.inner.x
}

fn read(a: &Outer, b: &Outer, big: @(a.inner.x > 5), same: @(a === b)) -> @(b.inner.x > 5) {
    big.rewrite(same) //~ error: `rewrite` finds nothing to replace: `same` is about the model of `a`, and `big` reads the field `a.inner.x`, which is no part of that model
}
