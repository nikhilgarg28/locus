//~ question: Does `eq::congr` carry an equality of models through a logic function that reads a field the model forgets?
//~ spec: core.elaboration, proofs.equality
//~ rfc: 0005

struct Inner {
    x: u32,
}

impl Model for Inner {
    type Logic = Nat;
    logic fn model(inner: Snap<Inner>) -> Nat {
        0
    }
}

#[derive(Model)]
struct Outer {
    inner: Inner,
}

logic fn x_of(o: Snap<Outer>) -> Nat {
    o.inner.x
}

fn read(a: &Outer, b: &Outer, same: @(a === b)) -> @(x_of(snap(a)) === x_of(snap(b))) {
    eq::congr(x_of, same) //~ error: `same` is an equality of the models of `a` and `b`, and `x_of` takes a snapshot: `eq::congr` needs a function of what the equality is between
}
