//~ question: Does `eq::congr` carry an equality of snapshots through a logic function that reads a field?
//~ spec: core.elaboration, proofs.equality
//~ rfc: 0005

struct Inner {
    x: u32,
}

impl View for Inner {
    type V = Nat;
    logic fn view(inner: Snap<Inner>) -> Nat {
        0
    }
}

struct Outer {
    inner: Inner,
}

logic fn x_of(o: Snap<Outer>) -> Nat {
    o.inner.x
}

// `snap(a) === snap(b)` is an equality of the two snapshots, and a snapshot is what `x_of` takes.
fn read(a: &Outer, b: &Outer, same: @(a === b)) -> @(x_of(snap(a)) === x_of(snap(b))) {
    eq::congr(x_of, same)
}
