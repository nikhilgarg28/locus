//~ question: Does `at` accept a proof that does not put the index inside the sequence?
//~ spec: core.sequences
//~ rfc: 0005

logic fn head(proofs: Seq<@True>) -> @True {
    proofs.at(0, linear(())) //~ error: cannot prove `0 < proofs.len()` from the facts given, of which there are none: it fails for an empty sequence
}
