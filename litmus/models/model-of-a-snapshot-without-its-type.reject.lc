//~ question: May `model` be applied to a snapshot value without naming the type it is a snapshot of?
//~ spec: models.observation
//~ rfc: 0002

struct Stack {
    items: Vec<u32>,
}

impl Model for Stack {
    type Logic = Seq<Nat>;
    logic fn model(stack: Snap<Stack>) -> Seq<Nat> {
        stack.items
    }
}

// `Shelf` declares no model, so its model is its snapshot, which holds `Stack`'s snapshot.
struct Shelf {
    stack: Stack,
}

fn same_stack(shelf: &Shelf) -> u32 {
    let whole = logic! { shelf };
    let same: @(model(whole.stack) === shelf.stack) = _; //~ error: `model` is given a snapshot value, whose type does not say which type it is a snapshot of: write `Stack::model(whole.stack)`
    0
}
