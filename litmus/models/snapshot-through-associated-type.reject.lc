//~ question: Does a type have a snapshot at a type argument whose associated type leads back to the type itself?
//~ spec: models.snapshots.seen
//~ rfc: 0002

trait Family {
    type Out: 'static;
}

struct Node<F: Family> {
    next: F::Out,
}

struct K;

impl Family for K {
    type Out = &'static Node<K>;
}

// rustc accepts this: `A.next` is `A`. No field's declared type shows the cycle,
// which closes through the `impl`.
static A: Node<K> = Node { next: &A };

logic fn absurd(s: Snap<Node<K>>) -> @False { //~ error: `Node<K>` has no snapshot: its field `next` is a `K::Out`, which is `&'static Node<K>`, so the snapshot of a `Node<K>` would hold itself
    absurd(s.next)
}
