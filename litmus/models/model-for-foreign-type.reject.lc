//~ question: May a crate declare the view of a type that another crate defines?
//~ spec: models.declared-by-owner
//~ rfc: 0002

use std::time::Instant;

impl View for Instant { //~ error: only the crate that defines `Instant`, or Locus's library, can declare its view
    type V = Nat;
    // `Instant` has no snapshot either: Locus does not lower the crate that declares it.
    logic fn view(i: Snap<Instant>) -> Nat {
        0
    }
}
