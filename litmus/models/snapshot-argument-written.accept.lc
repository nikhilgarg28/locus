//~ question: Is a snapshot given to a logic function by writing `snap`?
//~ spec: models.observation, logic.fn.parameters
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
    cap: usize,
}

impl View for Stack {
    type V = Seq<Nat>;
    logic fn view(stack: Snap<Stack>) -> Seq<Nat> {
        stack.items.elements()
    }
}

logic fn room(stack: Snap<Stack>) -> Int {
    stack.cap - stack.items.elements().len()
}

fn has_room(s: &Stack, some: @(room(snap(s)) > 0)) -> u32 {
    1
}
