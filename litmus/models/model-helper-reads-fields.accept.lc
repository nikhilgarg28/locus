//~ question: May a view call a logic function that reads the value's fields?
//~ spec: models.own-definition
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
}

logic fn size(stack: Snap<Stack>) -> Nat {
    stack.items.elements().len()
}

impl View for Stack {
    type V = Nat;
    logic fn view(stack: Snap<Stack>) -> Nat {
        size(stack)
    }
}
