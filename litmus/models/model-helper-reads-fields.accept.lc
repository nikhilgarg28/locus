//~ question: May a model call a logic function that reads the value's fields?
//~ spec: models.own-definition
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
}

logic fn size(stack: Snap<Stack>) -> Nat {
    stack.items.elements().len()
}

impl Model for Stack {
    type Logic = Nat;
    logic fn model(stack: Snap<Stack>) -> Nat {
        size(stack)
    }
}
