//~ question: May logical code capture a struct whose field of a type that Locus cannot see is wrapped in `Opaque<T>`?
//~ spec: models.snapshots.opaque, models.default
//~ rfc: 0002

use locus::Opaque;
use std::net::TcpListener;

struct Server {
    listener: Opaque<TcpListener>,
    port: u16,
}

// A move preserves the structural snapshot, including the wrapper's Unit field.
fn kept(server: Server) -> Server {
    let before = logic! { server };
    let moved = server;
    let same: @(moved === before) = _;
    moved
}
