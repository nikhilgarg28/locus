//~ question: May a type derive its model when one of its fields is marked `#[opaque]`?
//~ spec: models.derived
//~ rfc: 0002

use std::net::TcpListener;

#[derive(Model)] //~ error: cannot derive `Model` for `Server`: the field `listener` is marked `#[opaque]`, and its type `TcpListener` has no model
struct Server {
    #[opaque]
    listener: TcpListener,
    port: u16,
}
