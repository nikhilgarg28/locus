//~ question: May a type that reaches itself through a generic wrapper's reference derive its model?
//~ spec: models.derived
//~ rfc: 0002

struct Wrap<'a, T> {
    inner: &'a T,
}

#[derive(Model)] //~ error: Locus supplies no Model derive; write an explicit library view
struct Node<'a> {
    w: Wrap<'a, Node<'a>>,
}
