//~ question: May a type that reaches itself through a generic wrapper's reference derive its model?
//~ spec: models.derived
//~ rfc: 0002

struct Wrap<'a, T> {
    inner: &'a T,
}

#[derive(Model)] //~ error: cannot derive `Model` for `Node`: it reaches itself through the reference in `Wrap`'s field `inner`, so its field `w` is cut in its snapshot, and a cut field has no model
struct Node<'a> {
    w: Wrap<'a, Node<'a>>,
}
