//~ question: May a view reach itself through a logic function it calls?
//~ spec: models.own-definition
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
}

logic fn size(stack: Snap<Stack>) -> Nat {
    Stack::view(stack) //~ error: mutual logical recursion through the view and its helper is unsupported
}

impl View for Stack {
    type V = Nat;
    logic fn view(stack: Snap<Stack>) -> Nat {
        size(stack)
    }
}
