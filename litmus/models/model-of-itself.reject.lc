//~ question: Inside its own view function, may a snapshot be taken to the view being defined?
//~ spec: models.own-definition
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
}

impl View for Stack {
    type V = Seq<Nat>;
    logic fn view(stack: Snap<Stack>) -> Seq<Nat> {
        Stack::view(stack) //~ error: the recursive logical call does not decrease structurally or by a declared measure
    }
}
