//~ question: Is equality of two values of a type with a declared model the equality of their snapshots?
//~ spec: models.default, logic.eq.runtime-values
//~ rfc: 0002

struct Reading {
    degrees: i32,
    station: u32,
}

impl Model for Reading {
    type Logic = Int;
    logic fn model(r: Snap<Reading>) -> Int {
        r.degrees
    }
}

fn same(a: &Reading, b: &Reading, equal: @(a === b)) -> @(snap(a) === snap(b)) {
    _ //~ error: cannot prove `snap(a) === snap(b)`: `a === b` compares the declared model of `Reading`, which forgets `station`
}
