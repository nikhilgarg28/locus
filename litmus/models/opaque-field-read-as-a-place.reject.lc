//~ question: May a field marked `#[opaque]` be captured by reading it as a place?
//~ spec: models.snapshots.opaque, models.snapshots.seen
//~ rfc: 0002

use std::net::{SocketAddr, TcpListener};

struct Server {
    #[opaque]
    listener: TcpListener,
    #[opaque]
    local: SocketAddr,
    port: u16,
}

fn held(server: &Server) -> u32 {
    let listener = logic! { server.listener }; //~ error: `server.listener` is a place of type `TcpListener`, which has no model, so it cannot be captured; its opaque snapshot is `snap(server).listener`
    0
}
