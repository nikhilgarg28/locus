//~ question: Are two values equal when their type has a structural snapshot and all their fields are equal?
//~ spec: models.snapshots, logic.eq.runtime-values
//~ rfc: 0002

struct Point {
    x: u32,
    y: u32,
}

fn same(p: &Point, q: &Point, x: @(p.x === q.x), y: @(p.y === q.y)) -> @(p === q) {
    _
}
