//~ question: For a field whose declared view has its snapshot's own type, do both capture orders retain the same field?
//~ spec: models.capture.fields, models.snapshots
//~ rfc: 0002

struct Inner {
    n: u32,
}

// A view with the type of the snapshot: the snapshot with `n` replaced by 0.
impl View for Inner {
    type V = Snap<Inner>;
    logic fn view(s: Snap<Inner>) -> Snap<Inner> {
        Inner { n: 0 }
    }
}

// Capture of `Outer` holds `Inner`'s snapshot; its view is not applied.
struct Outer {
    inner: Inner,
}

fn both(outer: &Outer, seven: @(outer.inner.n == 7)) -> u32 {
    let whole = logic! { outer };
    let part = logic! { outer.inner };
    // Captured, then the field selected: the field's snapshot, in which `n` is 7.
    let kept: @(whole.inner.n == 7) = _;
    // The field selected, then captured: the same snapshot, in which `n` is 7.
    let retained: @(part.n == 7) = _;
    outer.inner.n
}
