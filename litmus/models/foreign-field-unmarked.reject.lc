//~ question: May a struct hold a field of a type that Locus cannot see, with no mark?
//~ spec: models.snapshots.opaque, models.snapshots.seen
//~ rfc: 0002

use std::net::TcpListener;

struct Server {
    listener: TcpListener, //~ error: `TcpListener` has no snapshot: Locus does not lower the crate that declares it, and Locus's library declares none for it; mark the field `#[opaque]`
    port: u16,
}
