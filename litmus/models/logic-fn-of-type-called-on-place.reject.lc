//~ question: Is a logic function that a runtime type declares found by a method call on a place of that type?
//~ spec: models.capture.methods
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
    cap: usize,
}

impl View for Stack {
    type V = Seq<Nat>;
    logic fn view(stack: Snap<Stack>) -> Seq<Nat> {
        stack.items.elements()
    }
}

impl Stack {
    logic fn room(stack: Snap<Stack>) -> Int {
        stack.cap - stack.items.elements().len()
    }
}

fn has_room(s: &Stack, some: @(s.room() > 0)) -> u32 { //~ error: the captured Stack snapshot has no room method; call Stack::room(snap(s)) explicitly
    1
}
