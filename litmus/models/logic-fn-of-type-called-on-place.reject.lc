//~ question: Is a logic function that a runtime type declares found by a method call on a place of that type?
//~ spec: models.capture.methods
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
    cap: usize,
}

impl Model for Stack {
    type Logic = Seq<Nat>;
    logic fn model(stack: Snap<Stack>) -> Seq<Nat> {
        stack.items.elements()
    }
}

impl Stack {
    logic fn room(stack: Snap<Stack>) -> Int {
        stack.cap - stack.items.elements().len()
    }
}

fn has_room(s: &Stack, some: @(s.room() > 0)) -> u32 { //~ error: `s` is captured as its model, a `Seq<Nat>`, which has no `room`, and nothing else is tried: call the logic function of `Stack` by its path, `Stack::room(snap(s))`
    1
}
