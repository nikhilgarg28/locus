//~ question: Does tuple capture compose component snapshots without applying their views?
//~ spec: models.by-parts
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
}

impl View for Stack {
    type V = Seq<Nat>;
    logic fn view(stack: Snap<Stack>) -> Seq<Nat> {
        stack.items.elements()
    }
}

// Structural capture of the tuple holds the stack's snapshot.
fn same_stack(pair: &(Stack, u32)) -> u32 {
    let whole = logic! { pair };
    let same: @(whole.0.items.elements().len() == pair.0.items.elements().len()) = _;
    0
}
