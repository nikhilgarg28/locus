//~ question: May two hand-written models depend on each other?
//~ spec: models.own-definition
//~ rfc: 0002

struct Node {
    value: u32,
    next: Option<Box<Link>>,
}

struct Link {
    to: Node,
}

impl View for Node {
    type V = Nat;
    logic fn view(n: Snap<Node>) -> Nat {
        match n.next {
            Some(link) => Link::view(link), //~ error: these view implementations form unsupported mutual logical recursion
            None => n.value,
        }
    }
}

impl View for Link {
    type V = Nat;
    logic fn view(l: Snap<Link>) -> Nat {
        Node::view(l.to)
    }
}
