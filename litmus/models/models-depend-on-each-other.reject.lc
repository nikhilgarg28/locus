//~ question: May two hand-written models depend on each other?
//~ spec: models.own-definition
//~ rfc: 0002

struct Node {
    value: u32,
    next: Option<Box<Link>>,
}

struct Link {
    to: Node,
}

impl Model for Node {
    type Logic = Nat;
    logic fn model(n: Snap<Node>) -> Nat {
        match n.next {
            Some(link) => Link::model(link), //~ error: the model of `Node` depends on itself, through the model of `Link`
            None => n.value,
        }
    }
}

impl Model for Link {
    type Logic = Nat;
    logic fn model(l: Snap<Link>) -> Nat {
        Node::model(l.to)
    }
}
