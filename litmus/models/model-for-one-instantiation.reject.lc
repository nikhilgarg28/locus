//~ question: May a model be declared for one instantiation of a generic type?
//~ spec: models.one-per-type
//~ rfc: 0002

struct Wrap<T> {
    inner: T,
}

impl Model for Wrap<u32> { //~ error: a model is declared for `Wrap` at all its type arguments: `Wrap<u64>` would keep the default, and generic code would read one type through two models
    type Logic = Nat;
    logic fn model(w: Snap<Wrap<u32>>) -> Nat {
        w.inner
    }
}
