//~ question: May a model read the contents of a `Cell`?
//~ spec: models.frozen-data
//~ rfc: 0002

use std::cell::Cell;

struct Counter {
    hits: Cell<u32>,
}

impl Model for Counter {
    type Logic = Nat;
    logic fn model(c: &Counter) -> Nat {
        c.hits //~ error: expected `Nat`, found `Opaque<Cell<u32>>`: a `Cell`'s contents can change while it is shared, so its only model is its identity
    }
}
