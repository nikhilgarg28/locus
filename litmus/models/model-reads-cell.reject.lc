//~ question: May a model read the contents of a `Cell`?
//~ spec: models.frozen-data
//~ rfc: 0002

use std::cell::Cell;

struct Counter {
    hits: Cell<u32>,
}

impl Model for Counter {
    type Logic = Nat;
    logic fn model(c: Snap<Counter>) -> Nat {
        c.hits //~ error: `c.hits` is the snapshot of a `Cell<u32>`, which holds nothing of its contents, and not a `Nat`: a `Cell`'s contents can change while it is shared, so no snapshot or model holds them
    }
}
