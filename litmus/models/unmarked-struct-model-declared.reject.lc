//~ question: May a model be declared for a struct that has an unmarked field of a type that Locus cannot see?
//~ spec: models.snapshots.opaque
//~ rfc: 0002

use std::net::TcpListener;

struct Server {
    listener: TcpListener,
    port: u16,
}

impl Model for Server { //~ error: `Server` has no snapshot, so no model can be declared for it: its field `listener` is a `TcpListener`, which Locus cannot see; mark the field `#[opaque]`
    type Logic = Nat;
    logic fn model(server: Snap<Server>) -> Nat {
        server.port
    }
}
