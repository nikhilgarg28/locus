//~ question: May logical code take the length of a vector whose elements have no model, through its snapshot?
//~ spec: models.snapshots, models.no-default
//~ rfc: 0002

struct Point {
    x: u32,
    y: u32,
}

fn first(points: &Vec<Point>, nonempty: @(snap(points).len() > 0)) -> u32 {
    points[0].x
}
