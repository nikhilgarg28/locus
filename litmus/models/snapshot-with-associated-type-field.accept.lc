//~ question: May the snapshot of a value with an associated-type field be held and compared, where the function writes the bound that reads the field's type?
//~ spec: models.capture.bound, logic.eq.snapshots
//~ rfc: 0002

trait Family {
    type Out;
}

struct Holder<F: Family> {
    id: u32,
    item: F::Out,
}

fn kept<F: Family>(h: Holder<F>) -> Holder<F> where F::Out: Model {
    let before = logic! { snap(h) };
    let moved = h;
    let same: @(snap(moved) === before) = _;
    moved
}
