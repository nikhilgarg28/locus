//~ question: May a type declare one view of its own, reading frozen data?
//~ spec: models.one-per-type, models.declared-by-owner, models.frozen-data, models.own-definition
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
}

impl View for Stack {
    type V = Seq<Nat>;
    logic fn view(stack: Snap<Stack>) -> Seq<Nat> {
        stack.items.elements()
    }
}
