//~ question: May a type have two models?
//~ spec: models.one-per-type
//~ rfc: 0002

struct Celsius {
    degrees: i32,
}

impl View for Celsius {
    type V = Int;
    logic fn view(c: Snap<Celsius>) -> Int {
        c.degrees
    }
}

impl View for Celsius { //~ error: `Celsius` already has a view
    type V = Int;
    logic fn view(c: Snap<Celsius>) -> Int {
        c.degrees + 273
    }
}
