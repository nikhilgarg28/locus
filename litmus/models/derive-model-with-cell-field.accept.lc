//~ question: May a type have a structural snapshot when one of its fields is a `Cell`, whose payload is omitted from capture?
//~ spec: models.snapshots
//~ rfc: 0002

use std::cell::Cell;

struct Counter {
    id: u32,
    hits: Cell<u32>,
}

fn observed(c: &Counter) -> @(snap(c).id === c.id) { _ }
