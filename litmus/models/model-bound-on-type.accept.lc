//~ question: May a `Model` bound appear on a type's declaration, where a proof field reads a field that names the parameter?
//~ spec: models.bounds-on-functions, models.capture.bound
//~ rfc: 0002

use locus::std::vec::Vec;

struct Shelf<T: Model> {
    items: Vec<T>,
    limit: usize,
    fits: @(items.len() <= limit),
}

// Rust asks for the bound on every `impl` of a type that declares it.
impl<T: Model> Shelf<T> {
    fn limit(&self) -> usize {
        self.limit
    }
}
