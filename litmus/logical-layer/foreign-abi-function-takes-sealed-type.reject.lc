//~ question: Is a function whose ABI is not Rust's held to the foreign boundary's rule when nothing exports its name?
//~ spec: logic.boundary.foreign
//~ rfc: 0002

struct Positive {
    value: u32,
    nonzero: @(value > 0),
}

// A function with C's ABI exists to be handed to C as a pointer.
pub extern "C" fn on_value(p: Positive) -> u32 { //~ error: `on_value` has the ABI "C", so foreign code can call it, and its parameter `p` has the type `Positive`, which holds a proof
    100 / p.value
}
