//~ question: May a `sym` operand name a static that holds plain data?
//~ spec: logic.code.statics
//~ rfc: 0002

use std::arch::global_asm;

static LIMIT: u32 = 100;

// x86-64 assembly: a symbol that returns the address of `LIMIT`.
global_asm!(
    ".globl limit_address",
    "limit_address:",
    "lea rax, [rip + {limit}]",
    "ret",
    limit = sym LIMIT,
);

fn limit() -> u32 {
    LIMIT
}

//~ run: limit() => 100
