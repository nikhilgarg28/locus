//~ question: May a reference to a place that holds a proof be cast to a raw pointer?
//~ spec: logic.unverified.plain-rust
//~ rfc: 0002

fn check(x: u32) -> Option<@(x > 0)> {
    if x > 0 { Some(_) } else { None }
}

fn hold(x: u32) -> u32 {
    let mut found = check(x);
    let p = &mut found as *mut Option<@(x > 0)>; //~ error: `hold` handles a raw pointer, so it is unverified, and an unverified function handles no value whose type holds a proof
    x
}
