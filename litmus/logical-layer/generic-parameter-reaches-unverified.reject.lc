//~ question: May the program's own generic function be instantiated with a proof holder when it passes its argument on to unverified code?
//~ spec: logic.ghost.generic-instantiations, logic.boundary.plain-data
//~ rfc: 0002

// Nothing logical is in sight here, and with `u32` for `T` the function is fine.
fn pass<T>(x: T) -> T {
    std::hint::black_box(x)
}

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn divide(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    x / y
}

fn hundred_over(n: u32) -> u32 {
    match pass(check(n)) { //~ error: in `pass::<Option<@(n > 0)>>`, a value of type `T` is given to `black_box`, which Locus does not verify, so `T` cannot hold logical data
        Some(p) => divide(100, n, p),
        None => 0,
    }
}
