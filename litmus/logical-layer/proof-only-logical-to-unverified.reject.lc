//~ question: May a vector of a logical type whose only constructor needs a proof be lent to code Locus has no specification for?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

#[derive(Logical)]
struct Positive {
    n: Nat,
    positive: @(n > 0),
}

fn lend(p: Positive) -> usize {
    let mut held: Vec<Positive> = Vec::new();
    held.push(p);
    std::hint::black_box(&mut held); //~ error: `held` is a `Vec<Positive>`, which holds logical data, so it cannot be lent to `black_box`, which Locus does not verify
    held.len()
}
