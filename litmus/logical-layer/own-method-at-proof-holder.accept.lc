//~ question: May `pop`, which is a method of Locus's own `Vec`, be called on a vector whose elements hold proofs?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use locus::std::vec::Vec;

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn divide(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    x / y
}

fn hundred_over(n: u32) -> u32 {
    let mut found: Vec<Option<@(n > 0)>> = Vec::new();
    found.push(check(n));
    // `pop` is Locus's method. The library keeps the elements in the standard library's `Vec`,
    // and is trusted to give back what it was given.
    match found.pop() {
        Some(Some(positive)) => divide(100, n, positive),
        _ => 0,
    }
}

//~ run: hundred_over(4) => 25
//~ run: hundred_over(0) => 0
