//~ question: May a place holding a proof be lent mutably to code Locus has no specification for?
//~ spec: logic.boundary.unchecked, logic.boundary.writes, logic.boundary.payload
//~ rfc: 0002

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn lend(x: u32) -> bool {
    let mut found: Option<@(x > 0)> = check(x);
    std::hint::black_box(&mut found); //~ error: `found` holds a proof, so it cannot be lent mutably to `black_box`, which Locus has no specification for
    found.is_some()
}
