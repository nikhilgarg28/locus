//~ question: May a vector of values of an invariant type be lent mutably to unverified code?
//~ spec: logic.boundary.plain-data, logic.boundary.logical-data
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn widths(v: &mut Vec<Interval>) -> u32 {
    std::hint::black_box(&mut *v); //~ error: `Interval` has a proof field, so a `Vec<Interval>` cannot be lent to `black_box`, which Locus does not verify
    match v.first() {
        Some(iv) => {
            let ok: @(iv.lo <= iv.hi) = iv.ordered;
            iv.hi - iv.lo
        }
        None => 0,
    }
}
