//~ question: Does a function that assumes a fact stay verified, so that it may take a proof and the rest of it is checked?
//~ spec: proofs.assume, logic.unverified.functions
//~ rfc: 0002

// Stands for code that Locus does not verify, known to its author to return an even number.
#[unverified]
fn pick() -> u32 {
    10
}

fn halve(n: u32, even: @(n % 2 == 0)) -> u32 {
    n / 2
}

// Verified: its signature holds a proof, and `unsafe assume!` is not an `unsafe` block.
// The call of `halve` is checked like any other, against the proof that was assumed.
fn scaled_half(k: u32, small: @(k < 100)) -> u32 {
    let n = pick();
    let even: @(n % 2 == 0) = unsafe assume!(_);
    halve(n, even) + k
}

fn six() -> u32 {
    scaled_half(1, _)
}

//~ run: six() => 6
