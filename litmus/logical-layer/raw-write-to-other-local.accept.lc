//~ question: Does an unverified function that writes one local through a raw pointer leave what Locus knows about another?
//~ spec: logic.boundary.escape
//~ rfc: 0002

// Unverified: it contains `unsafe`. It can reach only what it is lent.
fn zero(m: &mut u32) {
    let p = m as *mut u32;
    unsafe {
        *p = 0;
    }
}

fn caller() -> u32 {
    let mut n: u32 = 1;
    let mut m: u32 = 2;
    zero(&mut m);
    let one: @(n == 1) = _;
    n + m
}

//~ run: caller() => 1
