//~ question: May a value of the program's own type with a proof field be lent mutably to code Locus does not verify?
//~ spec: logic.boundary.plain-data, logic.boundary.logical-data
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn lend(iv: &mut Interval) -> u32 {
    std::hint::black_box(&mut *iv);
    iv.hi - iv.lo
}
