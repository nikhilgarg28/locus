//~ question: May a channel of the standard library carry values that hold proofs?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use std::sync::mpsc;

fn lend(n: u32) -> bool {
    let (tx, rx) = mpsc::channel::<Option<@(n > 0)>>(); //~ error: `mpsc::channel` is the standard library's, which Locus does not verify, so it is not made at a type that holds a proof: its other half could be given a forged one
    drop(tx);
    rx.try_recv().is_ok()
}
