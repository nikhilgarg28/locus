//~ question: May the sending half of a channel of proofs be given to code Locus has no specification for?
//~ spec: logic.boundary.writable, logic.boundary.writes
//~ rfc: 0002

use std::sync::mpsc;

fn lend(n: u32) -> bool {
    let (tx, rx) = mpsc::channel::<Option<@(n > 0)>>();
    std::hint::black_box(tx.clone()); //~ error: `tx` sends values holding proofs, so it cannot be given to `black_box`, which Locus has no specification for: that code could send a forged proof that `rx` would receive
    rx.try_recv().is_ok()
}
