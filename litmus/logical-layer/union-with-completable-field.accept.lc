//~ question: May a union have a field that holds only completable logical values?
//~ spec: logic.ghost.no-unions, logic.boundary.completable
//~ rfc: 0002

union Tagged {
    bits: u64,
    count: Nat,
}

// Verified code can make one. Reading a union's field needs `unsafe`, and an
// unverified function takes no type that holds logical data, so no code of
// the crate reads it back.
fn make() -> Tagged {
    Tagged { bits: 7 }
}
