//~ question: May a function with a proof parameter become a function pointer?
//~ spec: logic.boundary.calls
//~ rfc: 0002

fn halve(n: u32, even: @(n % 2 == 0)) -> u32 {
    n / 2
}

fn pointer() -> u32 {
    let f: fn(u32, @(10 % 2 == 0)) -> u32 = halve; //~ error: `halve` needs a proof, so it cannot become a function pointer, which could be called without one
    f(10, _)
}
