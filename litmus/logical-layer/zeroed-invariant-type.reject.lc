//~ question: May a function make a value of a type with proof fields by `mem::zeroed`?
//~ spec: logic.unverified.plain-rust
//~ rfc: 0002

struct Positive {
    value: u32,
    nonzero: @(value > 0),
}

fn nothing() -> Positive {
    unsafe { std::mem::zeroed::<Positive>() } //~ error: `nothing` contains an `unsafe` block, so it is unverified, and an unverified function handles no invariant type
}
