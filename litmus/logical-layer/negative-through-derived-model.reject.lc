//~ question: May a logical type refer to itself negatively through a generated snapshot?
//~ spec: logic.types.positive
//~ rfc: 0002

struct Holder {
    b: Bad,
}

#[derive(Logical)]
struct Bad {
    f: logic fn(Snap<Holder>) -> @False, //~ error: `Bad` refers to itself, through the snapshot of `Holder`, in a parameter of a logical function type
}
