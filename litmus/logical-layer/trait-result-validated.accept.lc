//~ question: May verified code establish a property of a trait method's result by checking it at run time?
//~ spec: contracts.calls.unrelated
//~ rfc: 0002

trait OneByte {
    /// Returns an ASCII byte.
    fn byte(&self) -> u8;
}

struct High;

impl OneByte for High {
    fn byte(&self) -> u8 {
        0x80
    }
}

fn ascii(b: u8, small: @(b < 128)) -> u8 {
    b
}

fn first<P: OneByte>(p: &P) -> Option<u8> {
    let b = p.byte();
    if b < 128 {
        Some(ascii(b, _))
    } else {
        None
    }
}

//~ run: first(&High) => None
