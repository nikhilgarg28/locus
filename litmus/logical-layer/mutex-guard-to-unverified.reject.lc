//~ question: May a guard that gives mutable access to a proof be passed to unverified code?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use locus::std::sync::Mutex;

fn keep(n: u32) -> u32 {
    let slot: Mutex<Option<@(n > 0)>> = Mutex::new(None);
    if let Ok(guard) = slot.lock() {
        std::hint::black_box(guard); //~ error: the `MutexGuard` gives mutable access to `slot`'s contents, which hold a proof, so it cannot be passed to `black_box`
    }
    n
}
