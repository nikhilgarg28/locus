//~ question: May the assembly of a naked function name, with a `sym` operand, a function that takes a value of a sealed type?
//~ spec: logic.boundary.foreign
//~ rfc: 0002

use std::arch::naked_asm;

struct Positive {
    value: u32,
    nonzero: @(value > 0),
}

fn reciprocal(p: Positive) -> u32 {
    100 / p.value
}

// The naked function's own signature is plain. Its body, x86-64 assembly, jumps to `reciprocal`.
#[unsafe(naked)]
pub extern "C" fn trampoline(value: u32) -> u32 {
    naked_asm!("jmp {target}", target = sym reciprocal) //~ error: a `sym` operand gives `reciprocal` to assembly, which can call it with any bytes, and its parameter `p` has the type `Positive`, which holds a proof
}
