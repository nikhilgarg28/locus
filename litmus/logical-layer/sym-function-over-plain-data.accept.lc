//~ question: May `global_asm!` name, with a `sym` operand, a function over plain data that builds a value of a sealed type inside?
//~ spec: logic.boundary.foreign
//~ rfc: 0002

use std::arch::global_asm;

struct Positive {
    value: u32,
    nonzero: @(value > 0),
}

impl Positive {
    fn new(value: u32) -> Option<Positive> {
        if value > 0 { Some(Positive { value, nonzero: _ }) } else { None }
    }
}

fn divide(n: u32, d: u32, nonzero: @(d > 0)) -> u32 {
    n / d
}

// Verified, as any function with no `unsafe` code is. Being named below does not change that.
fn reciprocal(value: u32) -> u32 {
    match Positive::new(value) {
        Some(p) => divide(100, p.value, p.nonzero),
        None => 0,
    }
}

// x86-64 assembly: a symbol that C can call, which jumps to `reciprocal`.
global_asm!(
    ".globl reciprocal_entry",
    "reciprocal_entry:",
    "jmp {target}",
    target = sym reciprocal,
);

//~ run: reciprocal(4) => 25
//~ run: reciprocal(0) => 0
