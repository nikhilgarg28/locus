//~ question: May a function that needs a proof be turned into a trait object?
//~ spec: logic.boundary.calls
//~ rfc: 0002

fn halve(n: u32, even: @(n % 2 == 0)) -> u32 {
    n / 2
}

fn erase() -> u32 {
    let f: &dyn Fn(u32, @(10 % 2 == 0)) -> u32 = &halve; //~ error: `halve` needs a proof, so it cannot be turned into a trait object, through which code Locus does not check could call it
    f(10, _)
}
