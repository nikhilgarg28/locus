//~ question: May a function use `transmute` to give a proof holder the type of a holder of another proposition's proof?
//~ spec: logic.unverified.plain-rust
//~ rfc: 0002

fn divide(x: u32, y: u32, nonzero: @(y != 0)) -> u32 {
    x / y
}

fn forged(x: u32) -> u32 {
    let trivial: Option<@(1 == 1)> = Some(_);
    let cast: Option<@(0 != 0)> = unsafe { std::mem::transmute(trivial) }; //~ error: `forged` contains an `unsafe` block, so it is unverified, and an unverified function handles no value whose type holds a proof
    match cast {
        Some(p) => divide(x, 0, p),
        None => 0,
    }
}
