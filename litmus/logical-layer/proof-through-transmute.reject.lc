//~ question: Does a value given another type by `transmute` keep its proofs?
//~ spec: logic.ghost.forgotten
//~ rfc: 0002

fn divide(x: u32, y: u32, nonzero: @(y != 0)) -> u32 {
    x / y
}

fn forged(x: u32) -> u32 {
    let trivial: Option<@(1 == 1)> = Some(_);
    let cast: Option<@(0 != 0)> = unsafe { std::mem::transmute(trivial) }; //~ error: `transmute` gives back no proofs: `cast` holds markers, which prove nothing
    match cast {
        Some(p) => divide(x, 0, p),
        None => 0,
    }
}
