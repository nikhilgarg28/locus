//~ question: Does a logic function that is given a runtime place receive its capture, and give a logical result?
//~ spec: logic.code.logical-values, logic.fn.parameters
//~ rfc: 0002

logic fn count(xs: Seq<Nat>) -> Nat {
    xs.len()
}

fn nonempty(xs: &[u32], some: @(count(xs) > 0)) -> u32 {
    xs[0]
}
