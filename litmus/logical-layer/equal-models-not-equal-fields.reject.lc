//~ question: Does equality of two values' derived models give equality of fields that their fields' models forget?
//~ spec: logic.eq.runtime-values, models.snapshots
//~ rfc: 0002

struct Inner {
    x: u32,
}

impl View for Inner {
    type V = Nat;
    logic fn view(inner: Snap<Inner>) -> Nat {
        0
    }
}

struct Outer {
    inner: Inner,
}

fn read(a: &Outer, b: &Outer, same: @(Inner::view(snap(a.inner)) === Inner::view(snap(b.inner)))) -> @(a.inner.x === b.inner.x) {
    _ //~ error: cannot prove `a.inner.x === b.inner.x`: `a === b` compares models, and `Inner`'s view forgets `x`
}
