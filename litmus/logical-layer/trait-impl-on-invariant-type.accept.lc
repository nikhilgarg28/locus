//~ question: May a trait be implemented for a type with proof fields, when the signature holds no logical values?
//~ spec: logic.ghost.no-trait-impls, logic.unverified.functions
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

trait Width {
    fn width(&self) -> u32;
}

// `width` takes `Self`, which holds a proof, so it is verified, and verified code calls it.
impl Width for Interval {
    fn width(&self) -> u32 {
        self.hi - self.lo
    }
}

fn three() -> u32 {
    Interval { lo: 1, hi: 4, ordered: _ }.width()
}

//~ run: three() => 3
