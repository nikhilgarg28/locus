//~ question: May a proof field in the initializer of an associated constant of an `impl` that is generic over a constant be given by a call of a runtime function?
//~ spec: logic.const.well-founded
//~ rfc: 0002

struct Certified {
    proof: @False,
}

const fn never() -> @False {
    loop {}
}

struct Sized<const N: usize>;

impl<const N: usize> Sized<N> {
    const BAD: Certified = Certified { proof: never() }; //~ error: the proof field `proof` of `BAD` is given by a call of `never`: in a constant's initializer every proof comes from logical code, since rustc may never evaluate the call
}

fn absurd() -> @False {
    logic! { Sized::<3>::BAD.proof }
}
