//~ question: May a function make a value of a type with proof fields by `transmute`?
//~ spec: logic.unverified.plain-rust, logic.unsafe.invariant
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn backwards() -> Interval {
    unsafe { std::mem::transmute::<[u32; 2], Interval>([5, 1]) } //~ error: `backwards` contains an `unsafe` block, so it is unverified, and an unverified function handles no invariant type: build the `Interval` from its fields in verified code
}
