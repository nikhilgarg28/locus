//~ question: May a `Cell` holding a proof be lent, through a shared reference, to code Locus has no specification for?
//~ spec: logic.ghost.mutable-lending, logic.ghost.interior-mutability
//~ rfc: 0002

use std::cell::Cell;

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn lend(n: u32) -> bool {
    let slot: Cell<Option<@(n > 0)>> = Cell::new(check(n));
    std::hint::black_box(&slot); //~ error: `slot` holds a proof and has interior mutability, so a shared reference to it cannot be lent to `black_box`, which Locus has no specification for
    slot.get().is_some()
}
