//~ question: Does a value read through a raw pointer keep its proofs?
//~ spec: logic.ghost.forgotten
//~ rfc: 0002

fn divide(x: u32, y: u32, nonzero: @(y != 0)) -> u32 {
    x / y
}

fn forged(x: u32) -> u32 {
    let trivial: Option<@(1 == 1)> = Some(_);
    let ptr = &trivial as *const Option<@(1 == 1)> as *const Option<@(0 != 0)>;
    let read: Option<@(0 != 0)> = unsafe { *ptr }; //~ error: a value read through a raw pointer holds no proofs: `read` holds markers, which prove nothing
    match read {
        Some(p) => divide(x, 0, p),
        None => 0,
    }
}
