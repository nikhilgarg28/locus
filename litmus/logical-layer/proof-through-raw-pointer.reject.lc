//~ question: May a function that reads through a raw pointer take a value that holds logical data?
//~ spec: logic.unverified.plain-rust
//~ rfc: 0002

fn read(counts: &[Nat; 1]) -> usize { //~ error: `read` contains an `unsafe` block, so it is unverified, and its signature holds the logical type `Nat`
    let p = counts as *const [Nat; 1];
    let copy: [Nat; 1] = unsafe { *p };
    copy.len()
}
