//~ question: May a contract tie a `bool` result to a proposition with two implications, the result being a proposition on either side of `==>`?
//~ spec: logic.bool.as-proposition
//~ rfc: 0002

fn is_zero(x: u32) -> (r: bool, @((r ==> x == 0) && (x == 0 ==> r))) {
    (x == 0, _)
}

//~ run: is_zero(0).0 => true
//~ run: is_zero(3).0 => false
