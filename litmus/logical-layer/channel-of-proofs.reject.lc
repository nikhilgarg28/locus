//~ question: May a channel carry values that hold proofs?
//~ spec: logic.boundary.payload
//~ rfc: 0002

use std::sync::mpsc;

fn lend(n: u32) -> bool {
    let (tx, rx) = mpsc::channel::<Option<@(n > 0)>>(); //~ error: a channel is not one of the types that hold a proof: `Sender` and `Receiver` are neither plain containers nor types of the program's own
    rx.try_recv().is_ok()
}
