//~ question: May a proof be passed through the program's own generic function?
//~ spec: logic.ghost.not-type-argument
//~ rfc: 0002

fn identity<T>(value: T) -> T {
    value
}

fn relay(x: u32, positive: @(x > 0)) -> @(x > 0) {
    identity(positive) //~ error: a proof cannot instantiate the generic parameter `T` of `identity`
}
