//~ question: May a `Mutex` hold a proof?
//~ spec: logic.ghost.interior-mutability, logic.boundary.payload
//~ rfc: 0002

use std::sync::Mutex;

fn keep(n: u32) -> u32 {
    let slot: Mutex<Option<@(n > 0)>> = Mutex::new(None); //~ error: a `Mutex` cannot hold a proof: a type with interior mutability holds only completable logical values; keep the proof in a type of the program's own
    n
}
