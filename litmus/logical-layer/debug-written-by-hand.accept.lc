//~ question: May a type with a proof field leave the proof out of its `{:?}` output, through a `Debug` written over its plain fields?
//~ spec: logic.boundary.plain-data, logic.boundary.logical-data
//~ rfc: 0002

use std::fmt;

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

// Verified, since it takes `Self`. It hands the formatter plain fields only,
// where the derived `Debug` would also print `ordered: Proof`.
impl fmt::Debug for Interval {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_struct("Interval").field("lo", &self.lo).field("hi", &self.hi).finish()
    }
}

// The formatting code is not verified. It holds the interval, and cannot open it.
fn shown() -> String {
    format!("{:?}", Interval { lo: 1, hi: 4, ordered: _ })
}

//~ run: shown() => "Interval { lo: 1, hi: 4 }"
