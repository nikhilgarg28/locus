//~ question: May a function that contains an `unsafe` block state a proof?
//~ spec: logic.unverified.functions, logic.unverified.plain-rust
//~ rfc: 0002

fn raw() -> u32 {
    let mut n: u32 = 1;
    let p = &mut n as *mut u32;
    unsafe {
        *p = 0;
    }
    let one: @(n == 1) = _; //~ error: `raw` contains an `unsafe` block, so it is unverified, and an unverified function holds no logical code
    100 / n
}
