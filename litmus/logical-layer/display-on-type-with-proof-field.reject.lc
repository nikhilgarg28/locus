//~ question: May a value of a type with a proof field be formatted by the standard library through its `Display` implementation?
//~ spec: logic.boundary.plain-data, logic.boundary.logical-data
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

impl std::fmt::Display for Interval {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "[{}, {}]", self.lo, self.hi)
    }
}

fn shown() -> String {
    Interval { lo: 1, hi: 4, ordered: _ }.to_string() //~ error: `to_string` is library code without a specification, and `Interval` has a proof field, so it cannot be given a value of it; format the fields instead
}
