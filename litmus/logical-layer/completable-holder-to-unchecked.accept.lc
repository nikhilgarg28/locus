//~ question: May a vector of naturals be lent mutably to code Locus has no specification for?
//~ spec: logic.boundary.writes, logic.ghost.forgotten
//~ rfc: 0002

fn lend(n: Nat) -> usize {
    let mut counts: Vec<Nat> = Vec::new();
    counts.push(n);
    std::hint::black_box(&mut counts);
    counts.len()
}
