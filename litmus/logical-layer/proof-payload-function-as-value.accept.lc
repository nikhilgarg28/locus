//~ question: May a function whose parameter holds a proof inside an `Option` be used as a value in checked code?
//~ spec: logic.boundary.calls
//~ rfc: 0002

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn divide(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    x / y
}

fn hundred_over(n: u32, positive: Option<@(n > 0)>) -> u32 {
    match positive {
        Some(p) => divide(100, n, p),
        None => 0,
    }
}

fn pick() -> u32 {
    let f = hundred_over;
    f(5, check(5))
}

//~ run: pick() => 20
