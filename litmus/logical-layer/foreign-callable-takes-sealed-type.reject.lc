//~ question: May a function that foreign code can call take a value of a sealed type?
//~ spec: logic.boundary.foreign
//~ rfc: 0002

struct Positive {
    value: u32,
    nonzero: @(value > 0),
}

// C could call this with any bytes for `p`, and `p.nonzero` would then be a proof of `0 > 0`.
#[unsafe(no_mangle)]
pub extern "C" fn reciprocal(p: Positive) -> u32 { //~ error: foreign code can call `reciprocal`, and its parameter `p` has the type `Positive`, which holds a proof: take the plain value and build the `Positive` inside
    100 / p.value
}
