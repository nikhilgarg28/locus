//~ question: Is a proof holder accepted where its type states the same proposition about the same values?
//~ spec: logic.ghost.type-identity
//~ rfc: 0002

fn store(m: u32, slot: &mut Option<@(m > 0)>, positive: @(m > 0)) {
    *slot = Some(positive);
}

fn fill(n: u32, positive: @(n > 0)) -> bool {
    let mut found: Option<@(n > 0)> = None;
    store(n, &mut found, positive);
    found.is_some()
}

fn three() -> bool {
    fill(3, _)
}

//~ run: three() => true
