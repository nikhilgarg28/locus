//~ question: May a function that contains an `unsafe` block take a type of the program's own that holds logical data in a field, when that data is completable?
//~ spec: logic.unverified.plain-rust
//~ rfc: 0002

union Tagged {
    bits: u64,
    count: Nat,
}

fn bits(t: Tagged) -> u64 { //~ error: `bits` contains an `unsafe` block, so it is unverified, and its signature holds `Tagged`, whose field `count` holds the logical type `Nat`
    unsafe { t.bits }
}
