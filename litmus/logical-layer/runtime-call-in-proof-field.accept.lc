//~ question: May a call to a runtime function initialize a proof field?
//~ spec: logic.ghost.runtime-code-kept, logic.ghost.positions-logical
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn checked_order(lo: u32, hi: u32) -> @(lo <= hi) {
    if lo > hi {
        panic!("unordered");
    }
    _
}

fn interval(lo: u32, hi: u32) -> Interval {
    Interval { lo, hi, ordered: checked_order(lo, hi) }
}

fn width(lo: u32, hi: u32) -> u32 {
    let iv = interval(lo, hi);
    iv.hi - iv.lo
}

//~ run: width(2, 5) => 3
//~ run: width(5, 2) => panic
