//~ question: May a method that Locus's `Vec` only forwards to the standard library's be called on a vector of plain data?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use locus::std::vec::Vec;

fn without_first(mut items: Vec<u32>) -> usize {
    // `swap_remove` is not among the methods of Locus's `Vec`. Through `Deref` this is the
    // standard library's own `swap_remove`. It runs, and tells Locus nothing about `items`.
    items.swap_remove(0);
    items.len()
}

fn two_left() -> usize {
    let mut items = Vec::new();
    items.push(4);
    items.push(5);
    items.push(6);
    without_first(items)
}

//~ run: two_left() => 2
