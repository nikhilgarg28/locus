//~ question: Does a fact about a value that unchecked code returned survive a later call of unchecked code?
//~ spec: logic.boundary.escape
//~ rfc: 0002

fn owned() -> u32 {
    let mut b: Box<u32> = std::hint::black_box(Box::new(0));
    *b = 1;
    std::hint::black_box(());
    let one: @(*b == 1) = _;
    *b
}

//~ run: owned() => 1
