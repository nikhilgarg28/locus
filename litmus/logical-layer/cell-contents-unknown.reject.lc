fn same(a: &Cell<u32>, b: &Cell<u32>) -> @(snap(a) === snap(b)) {
    _ //~ error: cannot prove `snap(a) === snap(b)`: a `Cell`'s snapshot holds nothing of its contents, and nothing shows that the two come from one version
