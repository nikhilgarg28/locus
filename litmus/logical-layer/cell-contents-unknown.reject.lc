//~ question: Are two `Cell`s equal when nothing is known about where they came from?
//~ spec: models.default-identity
//~ rfc: 0002

use std::cell::Cell;

fn same(a: &Cell<u32>, b: &Cell<u32>) -> @(a === b) {
    _ //~ error: cannot prove `a === b`: a `Cell` has no model but its identity, and nothing shows that `a` and `b` are the same value
}
