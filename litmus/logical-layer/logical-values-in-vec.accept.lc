//~ question: May a vector hold logical values, keeping its length at run time?
//~ spec: logic.ghost.erased, logic.ghost.runtime-parts-kept
//~ rfc: 0002

fn logical_payloads() -> usize {
    let mut values: Vec<Nat> = Vec::new();
    values.push(logic! { 3 });
    values.push(logic! { 4 });
    let second: @(values[1] == 4) = _;
    values.len()
}

//~ run: logical_payloads() => 2
