//~ question: Does equality of two values' derived models give equality of their fields' models?
//~ spec: logic.eq.runtime-values, models.snapshots
//~ rfc: 0002

struct Inner {
    x: u32,
}

impl View for Inner {
    type V = Nat;
    logic fn view(inner: Snap<Inner>) -> Nat {
        0
    }
}

struct Outer {
    inner: Inner,
}

fn read(a: &Outer, b: &Outer, same: @(a === b)) -> @(a.inner === b.inner) {
    _
}
