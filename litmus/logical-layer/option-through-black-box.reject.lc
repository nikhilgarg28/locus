//~ question: May an `Option` holding a proof pass through code Locus has no specification for?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn divide(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    x / y
}

fn hundred_over(n: u32) -> u32 {
    match std::hint::black_box(check(n)) { //~ error: `check(n)` is an `Option` that holds a proof, so it cannot be given to `black_box`, which Locus does not verify
        Some(p) => divide(100, n, p),
        None => 0,
    }
}
