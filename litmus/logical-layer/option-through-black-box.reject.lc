//~ question: Does an `Option` holding a proof still hold it after passing through code Locus has no specification for?
//~ spec: logic.ghost.forgotten
//~ rfc: 0002

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn divide(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    x / y
}

fn hundred_over(n: u32) -> u32 {
    match std::hint::black_box(check(n)) {
        Some(p) => divide(100, n, p), //~ error: `p` is not a proof of `n > 0`: `black_box` forgets what its argument held, and gives back an `Option<Erased>`
        None => 0,
    }
}
