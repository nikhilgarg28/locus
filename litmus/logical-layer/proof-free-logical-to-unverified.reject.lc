//~ question: May a vector of a logical type whose constructors need no proof be lent to code Locus does not verify?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use locus::std::vec::Vec;

#[derive(Logical)]
enum Count {
    Zero,
    More(Nat),
}

fn lend(c: Count) -> usize {
    let mut held: Vec<Count> = Vec::new();
    held.push(c);
    std::hint::black_box(&mut held); //~ error: `held` is a `Vec<Count>`, which holds logical data, so it cannot be lent to `black_box`, which Locus does not verify
    held.len()
}
