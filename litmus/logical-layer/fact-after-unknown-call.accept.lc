//~ question: After unverified code is given mutable access to a local, does a fact about the local survive a later call of unverified code?
//~ spec: logic.boundary.escape
//~ rfc: 0002

fn later() -> u32 {
    let mut n: u32 = 1;
    std::hint::black_box(&mut n);
    n = 1;
    std::hint::black_box(());
    let one: @(n == 1) = _;
    n
}

//~ run: later() => 1
