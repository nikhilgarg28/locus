//~ question: May a proof be passed to a generic function that Locus does not verify?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use std::hint::black_box;

fn divide(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    x / y
}

// `black_box` is the standard library's, which Locus does not verify.
fn opaque(x: u32, y: u32, positive: @(y > 0)) -> u32 {
    let passed = black_box(positive); //~ error: `positive` is a proof, so it cannot be given to `black_box`, which Locus does not verify
    divide(x, y, passed)
}
