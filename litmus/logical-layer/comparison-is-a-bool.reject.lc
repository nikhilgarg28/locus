//~ question: Does `==` on integers give a `Bool`?
//~ spec: logic.eq.comparisons
//~ rfc: 0002

logic fn is_zero(n: Int) -> Bool {
    n == 0 //~ error: `n == 0` is a proposition, not a `Bool`: a comparison gives a `Prop`; declare the result `Prop`, or write `if n == 0 { true } else { false }`
}

logic fn zero(n: Int, z: @is_zero(n)) -> @(n === 0) {
    _
}
