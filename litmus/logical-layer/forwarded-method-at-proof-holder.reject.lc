//~ question: May a method that Locus's `Vec` only forwards to the standard library's be called on a vector whose elements hold proofs?
//~ spec: logic.boundary.plain-data
//~ rfc: 0002

use locus::std::vec::Vec;

fn check(n: u32) -> Option<@(n > 0)> {
    if n > 0 {
        Some(_)
    } else {
        None
    }
}

fn one_left(n: u32) -> usize {
    let mut found: Vec<Option<@(n > 0)>> = Vec::new();
    found.push(check(n));
    found.push(check(n));
    // `swap_remove` is not among the methods of Locus's `Vec`. Through `Deref` this is the
    // standard library's own `swap_remove`, called at an element type that holds a proof.
    found.swap_remove(0); //~ error: `swap_remove` is the standard library's, reached through `Deref`, and Locus does not verify it, so it cannot be called on a `Vec` whose elements hold proofs
    found.len()
}
