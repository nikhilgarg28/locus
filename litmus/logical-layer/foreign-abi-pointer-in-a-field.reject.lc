//~ question: Is a function pointer type whose ABI is not Rust's held to the foreign boundary's rule in the type of a field?
//~ spec: logic.boundary.foreign
//~ rfc: 0002

struct Positive {
    value: u32,
    nonzero: @(value > 0),
}

struct Hooks {
    make: extern "C" fn(u32) -> Positive, //~ error: the function pointer type `extern "C" fn(u32) -> Positive` has the ABI "C", and its result has the type `Positive`, which foreign code could make without its proof
}
