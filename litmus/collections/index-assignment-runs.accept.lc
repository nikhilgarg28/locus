//~ question: Does `v[i] = x` on a vector of Locus's library still write the element?
//~ spec: collections.vec.indexing
//~ rfc: 0002

use locus::std::prelude::*;
use locus::std::vec;

// `v[0] = 9` is `IndexMut::index_mut`, which Locus's library implements. It runs as Rust's does,
// and tells Locus nothing about `v`.
fn overwritten() -> u32 {
    let mut v: Vec<u32> = vec![1, 2, 3];
    v[0] = 9;
    v[0]
}

//~ run: overwritten() => 9
