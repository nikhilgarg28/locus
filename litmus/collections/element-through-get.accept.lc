//~ question: Does `get` of Locus's `Vec` say which element it returns?
//~ spec: collections.vec.contracts
//~ rfc: 0002

use locus::std::vec::Vec;

fn first(v: &Vec<u32>, some: @(0 < snap(v).elements().len())) -> (got: u32, @(snap(got) === snap(v).elements().at(0, some))) {
    // `same` proves that `x` has the snapshot of the element at 0.
    let (x, same) = v.get_checked(0, some);
    (*x, _)
}
