//~ question: Does the proof that `push` of Locus's `Vec` returns re-establish an invariant stated on the length of the vector's contents?
//~ spec: collections.vec.contracts, contracts.invariants
//~ rfc: 0002

use locus::std::vec::Vec;

struct Stack {
    items: Vec<u32>,
    cap: usize,
    // Stated on the contents, which is what the contracts of `Vec` speak of.
    fits: @(snap(items).elements().len() <= cap),
}

impl Stack {
    fn new(cap: usize) -> Stack {
        // `empty` returns a proof that the contents have length 0.
        let (items, empty) = Vec::empty();
        Stack { items, cap, fits: _ }
    }

    // The stack with `x` on it when there was room, and the stack as it was when there was none.
    fn push(self, x: u32) -> (Stack, bool) {
        let Stack { mut items, cap, fits } = self;
        // `counted` proves that `n` is the length of the contents.
        let (n, counted) = items.len_checked();
        if n < cap {
            // `grew` proves that the contents are one longer than they were.
            let grew = items.push_checked(x);
            (Stack { items, cap, fits: _ }, true)
        } else {
            (Stack { items, cap, fits }, false)
        }
    }
}

fn third_fits() -> bool {
    let (stack, first) = Stack::new(2).push(7);
    let (stack, second) = stack.push(8);
    let (stack, third) = stack.push(9);
    third
}

//~ run: third_fits() => false
