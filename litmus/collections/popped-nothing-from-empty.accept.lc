//~ question: Does `pop` of Locus's `Vec` say that a vector which gave `None` was empty?
//~ spec: collections.vec.contracts
//~ rfc: 0002

use locus::std::vec::Vec;

fn drained(v: &mut Vec<u32>) -> (empty: bool, @(empty ==> snap(v).elements().len() == 0)) {
    // `popped` proves that `last` is `None` exactly when the contents had length 0.
    let (last, popped) = v.pop_checked();
    match last {
        None => (true, _),
        Some(_) => (false, _),
    }
}
