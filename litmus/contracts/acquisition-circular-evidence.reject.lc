//~ question: Is reading an affected proof field after acquisition rejected even when other frozen evidence exists?
//~ spec: contracts.invariants.acquisition
//~ rfc: 0002

fn first_mut(pair: &mut (u32, u32))
    -> (x: &mut u32, @(final!(pair) === (final!(x), pair.1)))
{
    (&mut pair.0, _)
}

struct Tagged {
    data: (u32, u32),
    valid: @(data.1 == 7),
}

fn bad(owner: &mut Tagged) -> &mut u32 {
    let before = logic! { snap(owner.data) };
    let old = owner.valid;
    let r = &mut owner.data;
    let (x, loan) = first_mut(r);
    let circular = owner.valid; //~ error: proof field `valid` is suspended by the live acquisition; copy its evidence before taking the loan
    let kept: @(final!(r).1 == 7) = _;
    x
}
