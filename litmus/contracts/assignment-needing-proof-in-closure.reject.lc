//~ question: May a runtime closure assign a field that a proof field reads?
//~ spec: contracts.invariants.assignment
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn collapse(iv: &mut Interval) {
    let r = &mut *iv;
    let mut update = move || {
        r.hi = r.lo; //~ error: `hi` is read by the proof field `ordered`, so it is not assigned in place, inside a closure or anywhere else
    };
    update();
}
