//~ question: May a value that a proof field reads be written through a `Box` field?
//~ spec: contracts.invariants
//~ rfc: 0002

struct Positive {
    value: Box<u32>,
    nonzero: @(value > 0),
}

fn clear(p: &mut Positive) {
    *p.value = 0; //~ error: `value` is read by the proof field `nonzero`; replace the whole `Positive` instead
}
