//~ question: May a field that an invariant reads be assigned when the invariant holds for the new value?
//~ spec: contracts.invariants.assignment
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn widen(iv: &mut Interval) {
    iv.lo = 0; //~ error: `lo` is read by the proof field `ordered`, so it is not assigned in place; replace the whole `Interval`
}
