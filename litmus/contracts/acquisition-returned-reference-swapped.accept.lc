//~ question: Can a returned reference be swapped without invalidating a shape-only acquisition proof?
//~ spec: contracts.invariants.acquisition, contracts.final, runtime.borrows
//~ rfc: 0002

fn first_mut(pair: &mut (u32, u32))
    -> (x: &mut u32, @(final!(pair) === (final!(x), pair.1)))
{
    (&mut pair.0, _)
}

struct Tagged {
    data: (u32, u32),
    valid: @(data.1 == 7),
}

fn seven() -> u32 {
    let mut owner = Tagged { data: (0,7), valid: _ };
    let mut other: u32 = 0;
    let before = logic! { snap(owner.data) };
    let old = owner.valid;
    let r = &mut owner.data;
    let (mut x, loan) = first_mut(r);
    let kept: @(final!(r).1 == 7) = _;
    let mut y = &mut other;
    std::mem::swap(&mut x, &mut y);
    *x = 4;
    *y = 5;
    // No equation about which reference variable now names which endpoint is
    // inferred. The proof that the owner's tag stays seven was established.
    owner.data.1
}

//~ run: seven() => 7
