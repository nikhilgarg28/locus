//~ question: May a field that an invariant reads be changed through a borrow, inside a block that proves the invariant again at its end?
//~ issue: opening-invariants
//~ spec: contracts.invariants.no-mutable-borrow
//~ rfc: 0002

struct NonEmpty {
    items: Vec<u32>,
    ok: @(items.len() > 0),
}

impl NonEmpty {
    fn one(x: u32) -> NonEmpty {
        NonEmpty { items: vec![x], ok: _ }
    }

    // Proposed: accepted. At the end of the block, `ok` is proved for the longer vector.
    fn push(&mut self, x: u32) {
        open!(self => {
            self.items.push(x);
        });
    }
}

fn two() -> usize {
    let mut n = NonEmpty::one(1);
    n.push(2);
    n.items.len()
}

//~ run: two() => 2
