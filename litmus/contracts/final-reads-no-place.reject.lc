//~ question: May `final!` appear in a body, naming a borrow after it has ended?
//~ spec: contracts.final
//~ rfc: 0002

fn after_borrow() -> u32 {
    let mut n: u32 = 1;
    let r = &mut n;
    *r = 5;
    n = n + 1;
    let was_five: @(final!(r) == 5) = _; //~ error: the loan named by `r` has ended; capture the current place to name its value after the loan
    n
}
