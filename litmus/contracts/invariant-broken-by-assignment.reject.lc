//~ question: May a field that an invariant reads be assigned when the invariant may not hold for the new value?
//~ spec: contracts.invariants.assignment
//~ rfc: 0002

struct Interval {
    lo: u32,
    hi: u32,
    ordered: @(lo <= hi),
}

fn shift(iv: &mut Interval) {
    iv.lo = 10; //~ error: `lo` is read by the proof field `ordered`, so it is not assigned in place; replace the whole `Interval`, which needs a proof that `10 <= hi`
}
