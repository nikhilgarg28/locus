//~ question: Must a block that opens an invariant prove it again at its end?
//~ spec: contracts.invariants.open
//~ rfc: 0002

struct NonEmpty {
    items: Vec<u32>,
    ok: @(items.len() > 0),
}

fn empty(n: &mut NonEmpty) {
    open!(n => {
        n.items.clear();
    }); //~ error: cannot prove the proof field `ok` at the end of the block: `n.items` is empty there
}
