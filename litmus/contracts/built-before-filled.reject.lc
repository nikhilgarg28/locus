//~ question: May a value with an invariant be built before the data that its invariant describes is in place?
//~ spec: contracts.invariants, contracts.invariants.observed
//~ rfc: 0002

use locus::std::vec::Vec;

struct Filled {
    items: Vec<u32>,
    len: usize,
    full: @(items.len() == len),
}

// The shape of a panic-safety bug: build the value first, and fill it afterwards.
// If filling panicked, a half-built `Filled` would be dropped as a whole one.
// Here no such value exists, because it cannot be built until its proof field holds.
fn filled(len: usize) -> Filled {
    Filled { items: Vec::new(), len, full: _ } //~ error: cannot prove `items.len() == len`: nothing relates the new vector's length to `len`
}
