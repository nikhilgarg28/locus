//~ question: Does a field holding an `Option` of a proof count as a proof field?
//~ spec: contracts.invariants
//~ rfc: 0002

struct Cache {
    x: u32,
    nonzero: Option<@(x != 0)>,
}

fn clear(c: &mut Cache) {
    c.x = 0; //~ error: `x` is read by the proof field `nonzero`; replace the whole `Cache` instead
}
