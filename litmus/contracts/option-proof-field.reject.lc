//~ question: Does a field holding an `Option` of a proof count as a proof field?
//~ spec: contracts.invariants.proof-holders, contracts.invariants.assignment
//~ rfc: 0002

struct Cache {
    x: u32,
    nonzero: Option<@(x != 0)>,
}

fn clear(c: &mut Cache) {
    c.x = 0; //~ error: `x` is read by the proof field `nonzero`, which may hold a proof that `x != 0`, so it is not assigned in place; replace the whole `Cache`
}
