//~ question: May a tuple component be written when a later component's proposition reads it?
//~ spec: contracts.invariants
//~ rfc: 0002

fn bump_first(v: &mut Vec<(i: usize, @(i < 10))>) {
    v[0].0 += 1; //~ error: `.0` is read by the proposition of the next component; replace the whole tuple instead
}
