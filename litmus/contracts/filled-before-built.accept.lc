//~ question: May a value with an invariant be built once the data that its invariant describes is in place?
//~ spec: contracts.invariants, contracts.invariants.observed
//~ rfc: 0002

struct Filled {
    items: Vec<u32>,
    len: usize,
    full: @(items.len() == len),
}

// `make` may panic. Until the last line there is only a plain vector,
// which unwinding drops as one.
fn filled(len: usize, make: fn() -> u32) -> Filled {
    let items: Vec<u32> = vec![make(); len];
    Filled { items, len, full: _ }
}

fn three() -> usize {
    filled(3, || 7).len
}

//~ run: three() => 3
