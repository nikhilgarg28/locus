//~ question: May a field holding proofs be assigned when another proof field reads it?
//~ spec: contracts.invariants.assignment, contracts.invariants.proof-holders
//~ rfc: 0002

use locus::std::prelude::*;
use locus::std::vec;

struct Hints {
    hints: Vec<@True>,
    nonempty: @(hints.len() > 0),
}

fn reset(s: &mut Hints) {
    let trivial: @True = True::Intro;
    s.hints = vec![trivial]; //~ error: `hints` is read by the proof field `nonempty`, so it is not assigned in place; replace the whole `Hints`
}
