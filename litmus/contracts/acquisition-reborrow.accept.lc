//~ question: Do reborrows of the returned reference preserve an already proved acquisition invariant?
//~ spec: contracts.invariants.acquisition, contracts.final, runtime.borrows
//~ rfc: 0002

fn first_mut(pair: &mut (u32, u32))
    -> (x: &mut u32, @(final!(pair) === (final!(x), pair.1)))
{
    (&mut pair.0, _)
}

struct Tagged {
    data: (u32, u32),
    valid: @(data.1 == 7),
}

fn seven() -> u32 {
    let mut owner = Tagged { data: (0,7), valid: _ };
    let before = logic! { snap(owner.data) };
    let old = owner.valid;
    let r = &mut owner.data;
    let (x, loan) = first_mut(r);
    let kept: @(final!(r).1 == 7) = _;
    let y = &mut *x;
    *y = 1;
    *x = 2;
    owner.data.1
}

//~ run: seven() => 7
