//~ question: Is an element loan rejected when arbitrary final values can violate the invariant?
//~ spec: contracts.invariants.acquisition
//~ rfc: 0002

fn first_mut(pair: &mut (u32, u32))
    -> (x: &mut u32, @(final!(pair) === (final!(x), pair.1)))
{ (&mut pair.0, _) }
struct Sorted { data: (u32,u32), sorted: @(data.0 <= data.1) }
fn bad(owner: &mut Sorted) -> &mut u32 {
    let before = logic! { snap(owner.data) };
    let old = owner.sorted;
    let r = &mut owner.data;
    let (x, loan) = first_mut(r);
    let kept: @(final!(r).0 <= final!(r).1) = _; //~ error: cannot prove the invariant for the arbitrary final value of the lent element
    x
}
