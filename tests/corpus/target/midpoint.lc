// A midpoint that cannot overflow, from Target examples, as written there.
// The specification is stated over Int, where the sum of two u32 cannot
// overflow; the code avoids the overflow the specification is free of. The
// obligations of `-` and `+` and the claim are discharged by the arithmetic
// procedure (E7); `2 != 0` by evaluation. With every promise of the logic
// and operators in its body, `midpoint` is checked as an ordinary function
// with its promises, by the interim rule of LOC-193. It takes evidence, so it is `pub(crate)` (O2).
#[terminates] #[no_panic] #[no_io]
pub(crate) fn midpoint(lo: u32, hi: u32, ordered: @(lo <= hi))
    -> (mid: u32, @(mid as Int == (lo as Int + hi as Int) / 2))
{
    let half = (hi - lo) / 2;          // the obligations of -: arithmetic, from ordered. 2 is not zero: evaluation
    let mid = lo + half;               // the obligations of +: arithmetic
    (mid, prove!(mid as Int == (lo as Int + hi as Int) / 2))   // arithmetic, with division by a literal
}

