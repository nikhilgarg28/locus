#[derive(Logical)] enum Maybe<T: Logical> { None, Some(T) }
#[derive(Logical)] enum Seq<T: Logical> { Empty, Cons { head: T, tail: Seq<T> } }
logic fn seq_get<T: Logical>(xs: Seq<T>, index: Int) -> Maybe<T> {
    match xs {
        Seq::Empty => Maybe::None,
        Seq::Cons { head, tail } => if index == 0 { Maybe::Some(head) } else { seq_get(tail, index - 1) },
    }
}
// Membership supplies an index witness separately from the proof that the
// lookup returned the requested value. It does not run a search for an index.
pub prop Contains(value: Int, items: Seq<Int>) {
    At { index: Int } => { prop!(seq_get(items, index) == Maybe::Some(value)) }
}

pub logic fn contains_head(value: Int, tail: Seq<Int>)
    -> @Contains(value, Seq::Cons { head: value, tail })
{
    Contains::At { index: 0 } @
        fold!(seq_get::<Int>, prove!(Maybe::<Int>::Some(value) == Maybe::<Int>::Some(value)))
}

// A concrete transition relation for the reachability example: a step may
// move forward. Reachable is the least relation generated by these two arms.
pub prop Reachable(from: Int, to: Int) {
    Same => { prop!(from == to) }
    Via { middle: Int } => { prop!(from <= middle && Reachable(middle, to)) }
}

pub logic fn reachable_ordered(from: Int, to: Int, path: @Reachable(from, to)) -> @(from <= to) {
    match path {
        Reachable::Same @ same => prove!(from <= to),
        Reachable::Via { middle } @ body => match body {
            And::Intro(first, rest) => {
                let tail = reachable_ordered(middle, to, rest);
                prove!(from <= to)
            }
        },
    }
}
