// Checked logical data. These declarations use the same parser and kernel
// as application code; none of their equations are trusted primitives.
#[derive(Logical)]
pub enum Peano { Zero, Succ(Peano) }

#[derive(Logical)]
pub enum Maybe<T: Logical> { None, Some(T) }

#[derive(Logical)]
pub enum Seq<T: Logical> { Empty, Cons { head: T, tail: Seq<T> } }

pub logic fn nat_to_int(n: Peano) -> Int {
    match n { Peano::Zero => 0, Peano::Succ(previous) => 1 + nat_to_int(previous) }
}

pub logic fn nat_nonnegative(n: Peano) -> @(nat_to_int(n) >= 0) {
    match n {
        Peano::Zero => fold!(nat_to_int, prove!(0 >= 0)),
        Peano::Succ(previous) => {
            let smaller = nat_nonnegative(previous);
            fold!(nat_to_int, prove!(1 + nat_to_int(previous) >= 0))
        }
    }
}

pub logic fn seq_length<T: Logical>(xs: Seq<T>) -> Int {
    match xs {
        Seq::Empty => 0,
        Seq::Cons { head, tail } => 1 + seq_length(tail),
    }
}

pub logic fn seq_get<T: Logical>(xs: Seq<T>, index: Int) -> Maybe<T> {
    match xs {
        Seq::Empty => Maybe::None,
        Seq::Cons { head, tail } => {
            if index == 0 { Maybe::Some(head) } else { seq_get(tail, index - 1) }
        }
    }
}

pub logic fn seq_append<T: Logical>(xs: Seq<T>, ys: Seq<T>) -> Seq<T> {
    match xs {
        Seq::Empty => ys,
        Seq::Cons { head, tail } => Seq::Cons { head, tail: seq_append(tail, ys) },
    }
}

pub logic fn seq_map<T: Logical, U: Logical>(xs: Seq<T>, transform: logic Fn(value: T) -> U) -> Seq<U> {
    match xs {
        Seq::Empty => Seq::Empty,
        Seq::Cons { head, tail } => Seq::Cons { head: transform(head), tail: seq_map(tail, transform) },
    }
}

pub logic fn seq_nonnegative<T: Logical>(xs: Seq<T>) -> @(seq_length(xs) >= 0) {
    match xs {
        Seq::Empty => fold!(seq_length::<T>, prove!(0 >= 0)),
        Seq::Cons { head, tail } => {
            let smaller = seq_nonnegative(tail);
            fold!(seq_length::<T>, prove!(1 + seq_length(tail) >= 0))
        }
    }
}

// Total on all Int values, clipping negative inputs to zero. The inverse
// law below requires the nonnegative evidence supplied by the caller.
pub logic fn nat_from_int(n: Int) -> Peano {
    if n <= 0 { Peano::Zero } else {
        let next = n - 1;
        let smaller: @(0 <= next && next < n) =
            And::Intro(prove!(0 <= next), prove!(next < n));
        Peano::Succ(recurse!(smaller, nat_from_int(next)))
    }
}

pub logic fn nat_to_from_int(n: Int, nonnegative: @(n >= 0))
    -> @(nat_to_int(nat_from_int(n)) == n)
{
    if n <= 0 {
        let base: @(nat_to_int(Peano::Zero) == n) =
            fold!(nat_to_int, prove!(0 == n));
        fold!(nat_from_int, base)
    } else {
        let next = n - 1;
        let next_nonnegative: @(next >= 0) = _;
        let smaller: @(0 <= next && next < n) =
            And::Intro(prove!(0 <= next), prove!(next < n));
        let induction = recurse!(smaller, nat_to_from_int(next, next_nonnegative));
        let step: @(nat_to_int(Peano::Succ(nat_from_int(next))) == n) =
            fold!(nat_to_int, prove!(1 + nat_to_int(nat_from_int(next)) == n));
        fold!(nat_from_int, step)
    }
}

pub logic fn nat_from_to_int(n: Peano) -> @(nat_from_int(nat_to_int(n)) == n) {
    match n {
        Peano::Zero => {
            let base: @(nat_from_int(0) == Peano::Zero) =
                fold!(nat_from_int, prove!(Peano::Zero == Peano::Zero));
            fold!(nat_to_int, base)
        }
        Peano::Succ(previous) => {
            let nonnegative = nat_nonnegative(previous);
            let induction = nat_from_to_int(previous);
            if 1 + nat_to_int(previous) <= 0 {
                let impossible: @False = _;
                match impossible {}
            } else {
                let subtract_one: @((1 + nat_to_int(previous)) - 1 == nat_to_int(previous)) = _;
                let rebuilt = Peano::Succ(nat_from_int((1 + nat_to_int(previous)) - 1));
                let initial: @(rebuilt == Peano::Succ(nat_from_int((1 + nat_to_int(previous)) - 1))) = _;
                let simplified: @(rebuilt == Peano::Succ(nat_from_int(nat_to_int(previous)))) =
                    rewrite!(subtract_one, initial);
                let equal: @(rebuilt == Peano::Succ(previous)) = rewrite!(induction, simplified);
                let step: @(nat_from_int(1 + nat_to_int(previous)) == Peano::Succ(previous)) =
                    fold!(nat_from_int, equal);
                fold!(nat_to_int, step)
            }
        }
    }
}

// The interface for callers that require an exact nonnegative conversion.
pub logic fn nat_from_nonnegative(n: Int, nonnegative: @(n >= 0)) -> Peano {
    nat_from_int(n)
}
// A signed mathematical integer defined in ordinary library code. Native Int
// remains the compact arithmetic backend; model links this fragment to it.
#[derive(Logical)]
pub enum LibraryInt { NonNegative(Peano), Negative(Peano) }

pub logic fn integer_model(value: LibraryInt) -> Int {
    match value {
        LibraryInt::NonNegative(n) => nat_to_int(n),
        LibraryInt::Negative(n) => -(nat_to_int(n) + 1),
    }
}

pub logic fn integer_negate(value: LibraryInt) -> LibraryInt {
    match value {
        LibraryInt::NonNegative(n) => match n {
            Peano::Zero => LibraryInt::NonNegative(Peano::Zero),
            Peano::Succ(previous) => LibraryInt::Negative(previous),
        },
        LibraryInt::Negative(n) => LibraryInt::NonNegative(Peano::Succ(n)),
    }
}

pub logic fn integer_nonnegative_roundtrip(n: Int, nonnegative: @(n >= 0))
    -> @(integer_model(LibraryInt::NonNegative(nat_from_int(n))) == n)
{
    let exact = nat_to_from_int(n, nonnegative);
    fold!(integer_model, exact)
}

pub logic fn integer_negative_model(n: Peano)
    -> @(integer_model(LibraryInt::Negative(n)) == -(nat_to_int(n) + 1))
{
    fold!(integer_model, prove!(-(nat_to_int(n) + 1) == -(nat_to_int(n) + 1)))
}
logic fn example() -> @(integer_model(LibraryInt::Negative(Peano::Succ(Peano::Zero))) == -2) {
    prove!(integer_model(LibraryInt::Negative(Peano::Succ(Peano::Zero))) == -2)
}
