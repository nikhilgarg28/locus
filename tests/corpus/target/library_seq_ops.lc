// Checked logical data. These declarations use the same parser and kernel
// as application code; none of their equations are trusted primitives.
#[derive(Logical)]
pub enum Nat { Zero, Succ(Nat) }

#[derive(Logical)]
pub enum Maybe<T: Logical> { None, Some(T) }

#[derive(Logical)]
pub enum Seq<T: Logical> { Empty, Cons { head: T, tail: Seq<T> } }

pub logic fn nat_to_int(n: Nat) -> Int {
    match n { Nat::Zero => 0, Nat::Succ(previous) => 1 + nat_to_int(previous) }
}

pub logic fn nat_nonnegative(n: Nat) -> @(nat_to_int(n) >= 0) {
    match n {
        Nat::Zero => fold!(nat_to_int, prove!(0 >= 0)),
        Nat::Succ(previous) => {
            let smaller = nat_nonnegative(previous);
            fold!(nat_to_int, prove!(1 + nat_to_int(previous) >= 0))
        }
    }
}

pub logic fn seq_length<T: Logical>(xs: Seq<T>) -> Int {
    match xs {
        Seq::Empty => 0,
        Seq::Cons { head, tail } => 1 + seq_length(tail),
    }
}

pub logic fn seq_get<T: Logical>(xs: Seq<T>, index: Int) -> Maybe<T> {
    match xs {
        Seq::Empty => Maybe::None,
        Seq::Cons { head, tail } => {
            if index == 0 { Maybe::Some(head) } else { seq_get(tail, index - 1) }
        }
    }
}

pub logic fn seq_append<T: Logical>(xs: Seq<T>, ys: Seq<T>) -> Seq<T> {
    match xs {
        Seq::Empty => ys,
        Seq::Cons { head, tail } => Seq::Cons { head, tail: seq_append(tail, ys) },
    }
}

pub logic fn seq_map<T: Logical, U: Logical>(xs: Seq<T>, transform: logic Fn(value: T) -> U) -> Seq<U> {
    match xs {
        Seq::Empty => Seq::Empty,
        Seq::Cons { head, tail } => Seq::Cons { head: transform(head), tail: seq_map(tail, transform) },
    }
}

pub logic fn seq_nonnegative<T: Logical>(xs: Seq<T>) -> @(seq_length(xs) >= 0) {
    match xs {
        Seq::Empty => fold!(seq_length::<T>, prove!(0 >= 0)),
        Seq::Cons { head, tail } => {
            let smaller = seq_nonnegative(tail);
            fold!(seq_length::<T>, prove!(1 + seq_length(tail) >= 0))
        }
    }
}

// Total on all Int values, clipping negative inputs to zero. The inverse
// law below requires the nonnegative evidence supplied by the caller.
pub logic fn nat_from_int(n: Int) -> Nat {
    if n <= 0 { Nat::Zero } else {
        let next = n - 1;
        let smaller: @(0 <= next && next < n) =
            And::Intro(prove!(0 <= next), prove!(next < n));
        Nat::Succ(recurse!(smaller, nat_from_int(next)))
    }
}

pub logic fn nat_to_from_int(n: Int, nonnegative: @(n >= 0))
    -> @(nat_to_int(nat_from_int(n)) == n)
{
    if n <= 0 {
        let base: @(nat_to_int(Nat::Zero) == n) =
            fold!(nat_to_int, prove!(0 == n));
        fold!(nat_from_int, base)
    } else {
        let next = n - 1;
        let next_nonnegative: @(next >= 0) = _;
        let smaller: @(0 <= next && next < n) =
            And::Intro(prove!(0 <= next), prove!(next < n));
        let induction = recurse!(smaller, nat_to_from_int(next, next_nonnegative));
        let step: @(nat_to_int(Nat::Succ(nat_from_int(next))) == n) =
            fold!(nat_to_int, prove!(1 + nat_to_int(nat_from_int(next)) == n));
        fold!(nat_from_int, step)
    }
}

pub logic fn nat_from_to_int(n: Nat) -> @(nat_from_int(nat_to_int(n)) == n) {
    match n {
        Nat::Zero => {
            let base: @(nat_from_int(0) == Nat::Zero) =
                fold!(nat_from_int, prove!(Nat::Zero == Nat::Zero));
            fold!(nat_to_int, base)
        }
        Nat::Succ(previous) => {
            let nonnegative = nat_nonnegative(previous);
            let induction = nat_from_to_int(previous);
            if 1 + nat_to_int(previous) <= 0 {
                let impossible: @False = _;
                match impossible {}
            } else {
                let subtract_one: @((1 + nat_to_int(previous)) - 1 == nat_to_int(previous)) = _;
                let rebuilt = Nat::Succ(nat_from_int((1 + nat_to_int(previous)) - 1));
                let initial: @(rebuilt == Nat::Succ(nat_from_int((1 + nat_to_int(previous)) - 1))) = _;
                let simplified: @(rebuilt == Nat::Succ(nat_from_int(nat_to_int(previous)))) =
                    rewrite!(subtract_one, initial);
                let equal: @(rebuilt == Nat::Succ(previous)) = rewrite!(induction, simplified);
                let step: @(nat_from_int(1 + nat_to_int(previous)) == Nat::Succ(previous)) =
                    fold!(nat_from_int, equal);
                fold!(nat_to_int, step)
            }
        }
    }
}

// The interface for callers that require an exact nonnegative conversion.
pub logic fn nat_from_nonnegative(n: Int, nonnegative: @(n >= 0)) -> Nat {
    nat_from_int(n)
}

// Appending preserves the exact sum of lengths. The recursive call is on
// the tail exposed by matching xs, and every fold produces checked evidence.
pub logic fn seq_append_length<T: Logical>(xs: Seq<T>, ys: Seq<T>)
    -> @(seq_length(seq_append(xs, ys)) == seq_length(xs) + seq_length(ys))
{
    match xs {
        Seq::Empty => {
            let empty: @(seq_length(ys) == seq_length(Seq::<T>::Empty) + seq_length(ys)) =
                fold!(seq_length::<T>, prove!(seq_length(ys) == 0 + seq_length(ys)));
            fold!(seq_append::<T>, empty)
        },
        Seq::Cons { head, tail } => {
            let induction = seq_append_length(tail, ys);
            let step: @(seq_length(Seq::<T>::Cons { head, tail: seq_append(tail, ys) })
                == seq_length(Seq::<T>::Cons { head, tail }) + seq_length(ys)) =
                fold!(seq_length::<T>, prove!(1 + seq_length(seq_append(tail, ys))
                    == 1 + seq_length(tail) + seq_length(ys)));
            fold!(seq_append::<T>, step)
        },
    }
}

logic fn maybe_value(value: Maybe<Int>) -> Int {
    match value { Maybe::None => 0, Maybe::Some(value) => value }
}
logic fn map_values() -> @(maybe_value(seq_get(seq_map(Seq::<Int>::Cons { head: 3, tail: Seq::Empty }, |n: Int| n + 1), 0)) == 4) {
    prove!(maybe_value(seq_get(seq_map(Seq::<Int>::Cons { head: 3, tail: Seq::Empty }, |n: Int| n + 1), 0)) == 4)
}
logic fn append_values() -> @(maybe_value(seq_get(seq_append(Seq::<Int>::Cons { head: 1, tail: Seq::Empty }, Seq::<Int>::Cons { head: 2, tail: Seq::Empty }), 1)) == 2) {
    prove!(maybe_value(seq_get(seq_append(Seq::<Int>::Cons { head: 1, tail: Seq::Empty }, Seq::<Int>::Cons { head: 2, tail: Seq::Empty }), 1)) == 2)
}
logic fn length_fact(xs: Seq<Int>) -> @(seq_length(xs) >= 0) { seq_nonnegative(xs) }
logic fn natural_fact(n: Nat) -> @(nat_to_int(n) >= 0) { nat_nonnegative(n) }
logic fn to_from(n: Int, nonnegative: @(n >= 0)) -> @(nat_to_int(nat_from_int(n)) == n) { nat_to_from_int(n, nonnegative) }
logic fn from_to(n: Nat) -> @(nat_from_int(nat_to_int(n)) == n) { nat_from_to_int(n) }
logic fn exact_natural(n: Int, nonnegative: @(n >= 0)) -> Nat { nat_from_nonnegative(n, nonnegative) }

logic fn appended_length(xs: Seq<Int>, ys: Seq<Int>)
    -> @(seq_length(seq_append(xs, ys)) == seq_length(xs) + seq_length(ys)) {
    seq_append_length(xs, ys)
}
