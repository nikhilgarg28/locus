// The operators at a boundary set of u8, i8, u32, and i64, each with
// the outcome Rust computes: one outcome holds in both builds; `=> panic
// | value` is the outcome with overflow checks on, then with them off.
// Generated by tools/operators.py; the corpus runner compares both
// interpreters in both modes and the Rust compiled both ways with it.

fn add_u8(a: u8, b: u8) -> u8 { a + b }
fn sub_u8(a: u8, b: u8) -> u8 { a - b }
fn mul_u8(a: u8, b: u8) -> u8 { a * b }
fn div_u8(a: u8, b: u8) -> u8 { a / b }
fn rem_u8(a: u8, b: u8) -> u8 { a % b }
fn add_i8(a: i8, b: i8) -> i8 { a + b }
fn sub_i8(a: i8, b: i8) -> i8 { a - b }
fn mul_i8(a: i8, b: i8) -> i8 { a * b }
fn div_i8(a: i8, b: i8) -> i8 { a / b }
fn rem_i8(a: i8, b: i8) -> i8 { a % b }
fn neg_i8(a: i8) -> i8 { -a }
fn add_u32(a: u32, b: u32) -> u32 { a + b }
fn sub_u32(a: u32, b: u32) -> u32 { a - b }
fn mul_u32(a: u32, b: u32) -> u32 { a * b }
fn div_u32(a: u32, b: u32) -> u32 { a / b }
fn rem_u32(a: u32, b: u32) -> u32 { a % b }
fn add_i64(a: i64, b: i64) -> i64 { a + b }
fn sub_i64(a: i64, b: i64) -> i64 { a - b }
fn mul_i64(a: i64, b: i64) -> i64 { a * b }
fn div_i64(a: i64, b: i64) -> i64 { a / b }
fn rem_i64(a: i64, b: i64) -> i64 { a % b }
fn neg_i64(a: i64) -> i64 { -a }

