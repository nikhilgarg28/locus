// A loop whose invariant is part of its state, and a bounded `for`.

fn walk(limit: u8) -> (out: u8, @(out <= limit)) {
    loop (i: u8 = 0, bound: @(i <= limit) = _) -> (out: u8, @(out <= limit)) {
        if i == limit {
            break (i, bound)
        } else {
            continue(limit, _)
        }
    }
}

// A `for` yields its final state, which is a tuple even of one value.
fn count(n: u8) -> u8 {
    let (total,) = for step in 0..n (total: u8 = 0) {
        continue(total.wrapping_add(1))
    };
    total
}

