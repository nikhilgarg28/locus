// A loop whose invariant is part of its state, and a bounded `for`. The
// invariant is established and kept by lemma calls, since `0 <= limit` and
// `limit <= limit` are not facts in scope.

fn walk(limit: u8) -> (out: u8, @(out <= limit)) {
    loop (i: u8 = 0, bound: @(i <= limit) = u8_zero_le(limit)) -> (out: u8, @(out <= limit)) {
        if i == limit {
            break (i, bound)
        } else {
            continue(limit, u8_le_refl(limit))
        }
    }
}

// A `for` yields its final state, which is a tuple even of one value.
fn count(n: u8) -> u8 {
    let (total,) = for step in 0..n (total: u8 = 0) {
        continue(total.wrapping_add(1))
    };
    total
}

