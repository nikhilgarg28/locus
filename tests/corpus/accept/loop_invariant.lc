// A `loop` whose value is what its `break` supplies, evidence included, and
// a bounded `for` that adds up what it assigns. The evidence at the break
// is about the values current there: `limit <= limit` by a lemma call, since
// `limit <= limit` is not a fact in scope. Evidence that must hold across
// passes, refreshed as the loop goes, is M4's tracked evidence.

fn walk(limit: u8) -> (out: u8, @(out <= limit)) {
    let mut i: u8 = 0;
    loop {
        if i == limit {
            break (limit, u8_le_refl(limit))
        } else {
            i = i.wrapping_add(1);
        }
    }
}

// What the `for` assigned is read after it; the loop itself is `()`.
fn count(n: u8) -> u8 {
    let mut total: u8 = 0;
    for step in 0..n {
        total = total.wrapping_add(1);
    }
    total
}

//~ proofs: 0
//~ run: walk(0) => (0, Proved)
//~ run: walk(9) => (9, Proved)
//~ run: count(0) => 0
//~ run: count(255) => 255
