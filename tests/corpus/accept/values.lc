// Every kind of value a run line can write: bytes, booleans, unit, tuples,
// structs, and enum variants with and without a payload.

#[derive(Clone, Copy, Debug)]
enum Shape {
    Dot,
    Line(u8),
    Box(u8, bool),
}

#[derive(Clone, Copy, Debug)]
struct Pixel {
    shape: Shape,
    lit: bool,
}

fn nothing() -> () {
    ()
}

fn swap(pair: (u8, bool)) -> (bool, u8) {
    (pair.1, pair.0)
}

fn only(n: u8) -> (u8,) {
    (n,)
}

fn toggle(pixel: Pixel) -> Pixel {
    if pixel.lit {
        Pixel { shape: pixel.shape, lit: false }
    } else {
        Pixel { shape: pixel.shape, lit: true }
    }
}

fn width(shape: Shape) -> u8 {
    match shape {
        Shape::Dot => 1,
        Shape::Line(length) => length,
        Shape::Box(side, _) => side,
    }
}

