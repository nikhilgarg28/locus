// A function of the logic whose body is executable is emitted too. A `Prop`
// it returns has no runtime form and is `Ghost`.

#[terminates] #[no_panic] #[no_io]
fn claim_of(n: u8) -> (claim: Prop, @claim) {
    let claim: Prop = prop!(n == n);
    (claim, _)
}

#[terminates] #[no_panic] #[no_io]
fn twice(n: u8) -> u8 {
    n.wrapping_add(n)
}

