// Promises: `#[terminates]`, `#[no_panic]`, `#[no_alloc]`, `#[no_io]`. A
// function keeps a promise only if everything it calls makes it, and a
// promise is never inferred. `#![no_io]` at the top of the file is made by
// every function in it, and an attribute on a function adds to it.
#![no_io]

// Promises constrain execution; they do not turn a runtime function into a
// logical definition. A separate explicit logical definition has an equation.
#[terminates] #[no_panic]
fn double(n: u8) -> (out: u8, @(out == n.wrapping_add(n))) {
    (n.wrapping_add(n), _)
}

logic fn sum_twice(n: Int) -> Int { n + n }

fn doubled(n: u8) -> (out: u8, @(out == n.wrapping_add(n))) {
    double(n)
}

logic fn back(n: Int, h: @(sum_twice(n) == 4)) -> @(n + n == 4) {
    unfold!(sum_twice, h)
}

logic fn forth(n: Int, h: @(n + n == 4)) -> @(sum_twice(n) == 4) {
    fold!(sum_twice, h)
}

// `no_panic` on `careful` adds to the file's `no_io`; `double` makes both.
#[no_panic]
fn careful(n: u8) -> u8 {
    double(n).0
}

// A function that promises nothing beyond the file's default calls anything.
fn run(n: u8) -> u8 {
    careful(n)
}

// A promise written twice, on the function and for the file, is one promise.
#[terminates] #[no_panic] #[no_io]
fn twice(n: u8) -> u8 {
    double(n).0
}

// A conditional and a `match` in a promised function.
#[derive(Clone, Copy, Debug)]
enum Mode {
    Off,
    On(u8),
}

#[terminates] #[no_panic]
fn level(mode: Mode) -> u8 {
    match mode {
        Mode::Off => 0,
        Mode::On(n) => if n < 10 { n } else { 10 },
    }
}

// A constant is a value of the logic, and calls a function the way a
// proposition does; one with a runtime form is computed by Rust itself,
// so it is a proposition that mentions a call, not a value.
const four_by_double: Prop = prop!(sum_twice(2) == 4);

fn four() -> (out: u8, @four_by_double) {
    (4, fold!(four_by_double, prove!(sum_twice(2) == 4)))
}

//~ proofs: 2
//~ run: double(3) => (6, Erased)
//~ run: doubled(21) => (42, Erased)
//~ run: careful(4) => 8
//~ run: run(100) => 200
//~ run: twice(200) => 144
//~ run: level(Mode::Off) => 0
//~ run: level(Mode::On(3)) => 3
//~ run: level(Mode::On(30)) => 10
//~ run: four() => (4, Erased)
//~ rust: fn double(n: u8) -> (u8, Erased) {
