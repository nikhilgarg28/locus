// The lock of examples/lock.lc with `u32` counts: the same program, the same
// proofs, with the lemmas of `u32` in place of those of `u8`. The failure
// count never exceeds the limit, and every function that hands the count on
// says so with evidence.

enum Event {
    Wrong,
    Right,
}

struct Lock {
    failures: u32,
    open: bool,
}

#[terminates] #[no_panic] #[no_io]
fn within_limit(failures: u32) -> Prop {
    prop!(failures <= 3)
}

// One transition. The caller proves the bound once; the result carries it on.
// Evidence is stated where it is not already in scope: `fold!` closes the
// definition of `within_limit` over evidence of its body, and a lemma call
// takes the step from `lock.failures < 3` to a bound on the successor.
fn step(
    lock: Lock,
    bounded: @within_limit(lock.failures),
    event: Event,
) -> (next: Lock, @within_limit(next.failures)) {
    match event {
        Event::Right => (Lock { failures: 0, open: true }, fold!(within_limit, prove!(0u32 <= 3))),
        Event::Wrong => {
            if lock.failures < 3 {
                let fits = u32_succ_le_of_lt(lock.failures, 3, prove!(lock.failures < 3));
                (Lock { failures: lock.failures.wrapping_add(1), open: false }, fold!(within_limit, fits))
            } else {
                (Lock { failures: lock.failures, open: false }, bounded)
            }
        }
    }
}

// The code is right on the attempt numbered `correct`, and wrong otherwise.
fn event_at(attempt: u32, correct: u32) -> Event {
    if attempt == correct { Event::Right } else { Event::Wrong }
}

// The invariant is loop state: evidence travels beside the lock it describes.
// `still_bounded` comes out of the call typed over `next`, so it is the
// evidence the next round needs, exactly.
fn run(attempts: u32, correct: u32) -> (last: Lock, @within_limit(last.failures)) {
    for attempt in 0..attempts (
        lock: Lock = Lock { failures: 0, open: false },
        bounded: @within_limit(lock.failures) = fold!(within_limit, prove!(0u32 <= 3)),
    ) {
        let (next, still_bounded) = step(lock, bounded, event_at(attempt, correct));
        continue(next, still_bounded)
    }
}

// Needs the bound: without it the subtraction could wrap. `unfold!` opens
// the definition, and the lemma says a difference under the bound stays
// under it.
fn remaining(failures: u32, bounded: @within_limit(failures)) -> (left: u32, @(left <= 3)) {
    (3.wrapping_sub(failures), u32_sub_le(3, failures, unfold!(within_limit, bounded)))
}

// The caller reuses the evidence `run` returned; nothing is proved twice.
fn attempts_left(attempts: u32, correct: u32) -> u32 {
    let (last, bounded) = run(attempts, correct);
    let (left, _) = remaining(last.failures, bounded);
    left
}

