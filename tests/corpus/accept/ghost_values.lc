// Logic-only types, and the one erasure rule (E8). `Ghost<T>` is a logical
// value of type `T` that the program never computes: `snapshot!(x)` builds
// one, a `let`, a parameter, or a field may be declared one, and in a
// proposition it reads as its `T` value. `Int` is logic-only too. A `let`
// of either is a logic-only context, elaborated where nothing runs, and
// erases to nothing; a parameter or a field of either is the marker `Ghost`
// in the generated Rust, as evidence is `Proved`.
//
// Two rules about calls, which must not be confused. An erased result: a
// call whose result has no runtime form keeps the call, which may panic or
// loop, and only its result vanishes. An erasable computation: a call is
// removed only when its result has no runtime form and the callee
// promises `terminates`, `no_panic`, and `no_io`.

// A snapshot names the value a claim speaks of, as it was.
fn keep(x: u8) -> (out: u8, @(out == x)) {
    let before = snapshot!(x);
    let out = x;
    (out, prove!(out == before))
}

// A `let` of type `Int` never runs, so it is written in any function.
fn widened(n: u8) -> (out: u8, @(out as Int == n as Int)) {
    let wide: Int = n as Int;
    (n, prove!(n as Int == wide))
}

// A `Ghost<T>` parameter is the marker at runtime, and the value in the
// claims about the other parameters.
fn under(n: u8, cap: Ghost<u8>, h: @(n <= cap)) -> (out: u8, @(out <= cap)) {
    (n, h)
}

// What stands in a `Ghost<T>` position is a logical value: a snapshot, or
// a value read where nothing runs.
fn under_limit(n: u8, h: @(n <= 200)) -> u8 {
    let (out, _) = under(n, snapshot!(200), h);
    let (again, _) = under(out, 200, _);
    again
}

// A `Ghost<T>` field holds a historical value, with evidence about it.
#[derive(Clone, Copy, Debug)]
struct Historical {
    value: Ghost<u8>,
    evidence: @(value != 0),
}

fn record(x: u8, h: @(x != 0)) -> Historical {
    Historical { value: snapshot!(x), evidence: h }
}

// The field is read in a proposition, where it is its `u8` value.
fn recorded(r: Historical) -> @(r.value != 0) {
    r.evidence
}

fn record_then_read(x: u8, h: @(x != 0)) -> u8 {
    let r = record(x, h);
    let again = recorded(r);
    x
}

// A variant may carry one too, and a `match` binds it.
#[derive(Clone, Copy, Debug)]
enum Tagged {
    Plain,
    Noted { at: Ghost<u8>, small: @(at <= 9) },
}

fn note(x: u8, h: @(x <= 9)) -> Tagged {
    Tagged::Noted { at: snapshot!(x), small: h }
}

fn noted(t: Tagged) -> u8 {
    match t {
        Tagged::Plain => 0,
        Tagged::Noted { at, small } => 1,
    }
}

fn note_then_read(x: u8, h: @(x <= 9)) -> u8 {
    noted(note(x, h))
}

// A function of the logic in a logic-only context: the call is absent
// from the generated Rust, and its defining equation serves the proof.
#[terminates] #[no_panic] #[no_io]
fn double(n: u8) -> u8 {
    n.wrapping_add(n)
}

fn doubled_noted(n: u8) -> (out: u8, @(out == double(n))) {
    let noted: Ghost<u8> = double(n);
    let out = double(n);
    (out, prove!(out == noted))
}

// Every promise of the logic and an operator in the body: by the interim
// rule of LOC-193 `bounded_by` is an ordinary function with its promises,
// and a call of it that returns only evidence is an erasable computation,
// removed from the generated Rust.
#[terminates] #[no_panic] #[no_io]
fn bounded_by(n: u8, h: @(n <= 200)) -> @(n as Int + 50 <= 255) {
    let s = n + 50;
    _
}

fn with_room(n: u8, h: @(n <= 200)) -> u8 {
    let room = bounded_by(n, h);
    n + 50
}

// An ordinary function that returns only evidence and may panic: the call
// stays, its result is `Proved`, and the panic is seen in every build that
// checks overflow.
fn checked(x: u8) -> @(x <= 255) {
    let _ = 255u8 + x;
    _
}

fn use_checked(x: u8) -> u8 {
    let h = checked(x);
    x
}

// The same for one that never returns.
fn spin_evidence(x: u8) -> @(x == x) {
    loop {}
}

fn use_spin(x: u8) -> u8 {
    let h = spin_evidence(x);
    x
}

