// A half-written file checks: `todo!()` stands for a body, or the rest of
// one, of any type, and the finished parts are checked and run around it.

#[derive(Clone, Copy, Debug)]
struct Account {
    balance: u8,
    holds: u8,
}

fn available(account: Account) -> u8 {
    if account.holds <= account.balance {
        account.balance.wrapping_sub(account.holds)
    } else {
        0
    }
}

fn deposit(account: Account, amount: u8) -> Account {
    todo!()
}

fn withdraw(account: Account, amount: u8) -> (out: Account, @(model!(out.holds) == model!(account.holds))) {
    let room = available(account);
    if amount <= room {
        todo!("the withdrawal itself")
    } else {
        (account, _)
    }
}

fn settle(account: Account) -> u8 {
    let cleared: Account = todo!();
    available(cleared)
}

