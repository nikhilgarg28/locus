// Evidence for one named proposition is not evidence of another.
prop Tiny(n: Int) { Below => { prop!(n < 3) } }
prop Small(n: Int) { Below => { prop!(n < 3) } }
logic fn wrong(n: Int, proof: @Tiny(n)) -> @Small(n) {
    proof //~ error: L0230 this is evidence of `Tiny(n)`, and `Small(n)` is needed
}
