// Pasted Rust either parses or is told, construct by construct, that it is
// not in Locus yet. One construct is one error, and the rest is still read.
#[derive(Debug)]
pub struct Counter {
    count: u8,
}

pub fn visible() -> u8 { 1 }

// Module imports are covered by the project fixtures.

impl Counter {
    fn get(&self) -> u8 { self.count }
}

impl<T> Counter<T> { } //~ error: L0116 generic inherent impls

fn assigned(n: u8) -> u8 {
    let mut total = n;
    total += 1; //~ error: L0116 compound assignment (`+=`)
    total = 2;
    total
}

fn borrowed(n: &u8) -> u8 { *n }

fn raw(n: *mut u8) -> u8 { 1 } //~ error: L0116 dereferences and raw pointers (`*`)

fn looped(n: u8) -> u8 {
    while n < 3 { };
    let r = 0..=n; //~ error: L0116 inclusive ranges (`..=`) are not in Locus yet, except in the header of a `for`
    return n;
}

fn lifetimes<'a>() -> u8 { 1 }

fn literals() -> u8 {
    let letter = 'x'; //~ error: L0005 character literals
    let half = 0.5; //~ error: L0005 float literals
    let bytes = b"raw"; //~ error: L0005 byte strings
    1
}
