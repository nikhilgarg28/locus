// An operator on a machine type may panic, so it is not a proposition: the
// same test that admits `a as Int + b as Int`, which is total, and
// `a.wrapping_add(b)`, which never panics, rejects `a + b` in a formula.
// In the body of a function that makes every promise of the logic it is
// allowed, and makes the function one known by its contract only
// (`not_a_term.lc`).
fn in_prop(a: u8, b: u8) -> Prop {
    prop!(a + b <= 255) //~ error: L0236 `+` on `u8` may panic, on overflow, so it is not a proposition
}

fn in_prove(a: u8, b: u8) -> u8 {
    prove!(a * b <= 255); //~ error: L0236 `*` on `u8` may panic, on overflow, so it is not a proposition
    a
}

fn in_a_claim(a: i32, b: i32, h: @(a / b == 2)) -> i32 { //~ error: L0236 `/` on `i32` may panic, on a zero divisor, so it is not a proposition
    a
}

fn negated(a: i8) -> Prop {
    prop!(-a == 3) //~ error: L0236 `-` on `i8` may panic, on overflow, so it is not a proposition
}

// On `Int` the operators are total and stand anywhere; a value of `Int` is
// still not a proposition.
fn int_as_prop(a: u8) -> Prop {
    prop!(a as Int + 1) //~ error: L0220 expected `Prop`, found `Int`
}
