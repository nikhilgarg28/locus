// Formula operands use their mathematical models; arbitrary products still
// require a proof, and an integer expression alone is not a proposition.
fn in_prop(a: u8, b: u8) -> Prop { prop!(a + b <= 255) }
fn in_prove(a: u8, b: u8) -> u8 {
    prove!(a * b <= 255); //~ error: L0230 cannot show `a * b <= 255`
    a
}
fn in_a_claim(a: i32, b: i32, h: @(a / b == 2)) -> i32 { a }
fn negated(a: i8) -> Prop { prop!(-a == 3) }
fn int_as_prop(a: u8) -> Prop {
    prop!(a as Int + 1) //~ error: L0220 expected `Prop`, found `Int`
}
