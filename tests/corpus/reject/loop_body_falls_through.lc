// Loop bodies that reach their end without `continue(...)` or `break`.
fn count(n: u8) -> u8 {
    for i in 0..n (total: u8 = 0) { //~ error: L0216 every path through the body of a `for` must end in `continue(...)`
        total.wrapping_add(1)
    }
}

fn spin(n: u8) -> u8 {
    loop (total: u8 = 0) -> u8 { //~ error: L0216 every path through a loop must end in `continue(...)` or `break`
        total.wrapping_add(1)
    }
}
