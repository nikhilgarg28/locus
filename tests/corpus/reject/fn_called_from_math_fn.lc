// A function of the logic promises terminates, no_panic, and no_io, and a promise is
// kept only if everything the function calls makes it.
fn first(n: u8) -> u8 { n }

#[terminates] #[no_panic] #[no_io] fn second(n: u8) -> u8 {
    first(n) //~ error: L0232 `second` promises terminates and calls `first`, which does not
}
