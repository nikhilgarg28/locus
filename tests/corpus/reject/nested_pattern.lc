// A pattern inside a variant that is not a name or `_`, on data and on evidence.
enum Light {
    Red,
    Amber((u8, u8)),
}

fn wait(light: Light) -> u8 {
    match light {
        Light::Red => 0,
        Light::Amber((seconds, tenths)) => seconds, //~ error: L0290 patterns inside a variant are names or `_` for now
    }
}

math fn first(p: Prop, q: Prop, r: Prop, all: @[p && (q && r)]) -> @p {
    match all {
        And::Intro(hp, And::Intro(hq, hr)) => hp, //~ error: L0290 patterns inside a variant are names or `_` for now
    }
}
