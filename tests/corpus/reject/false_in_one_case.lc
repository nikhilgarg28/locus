// Each named arm exposes its body, but a false consequence stays unproved.
prop SmallPrime(n: Int) {
    Two => { prop!(n == 2) }
    Seven => { prop!(n == 7) }
}
logic fn too_small(n: Int, h: @SmallPrime(n)) -> @(n <= 6) {
    match h {
        SmallPrime::Two @ two => prove!(n <= 6),
        SmallPrime::Seven @ seven => _, //~ error: L0230 cannot show `n <= 6`
    }
}
