// A hole takes no connective apart: `p && q` is not shown from `p` and
// `q`, `p || q` from either, nor an implication by assuming its premise.
// Each is a constructor or a function of the logic, and the diagnostic
// names which.
#[terminates] #[no_panic] #[no_io] fn both(p: Prop, q: Prop, hp: @p, hq: @q) -> @(p && q) {
    _ //~ error: L0230 cannot show `p && q`
}

#[terminates] #[no_panic] #[no_io] fn either(p: Prop, q: Prop, hq: @q) -> @(p || q) {
    _ //~ error: L0230 cannot show `p || q`
}

#[terminates] #[no_panic] #[no_io] fn implied(p: Prop, q: Prop, hq: @q) -> @(p => q) {
    _ //~ error: L0230 cannot show `p => q`
}
//~ spec: 1.8:3
