// A claim about one unknown byte is no longer decided by evaluating all
// 256 cases. When one lemma takes the step, the diagnostic names the call;
// when none does, it says that a lemma or a `prove!` stepping stone is
// what is missing. Neither claim is refuted: both hold for every byte the
// facts allow.
fn bump(n: u8, small: @(n < 10)) -> (out: u8, @(out <= 10)) {
    (n.wrapping_add(1), _) //~ error: L0230 cannot show `n.wrapping_add(1) <= 10`
}

fn headroom(n: u8, small: @(n <= 250)) -> (out: u8, @(out >= 5)) {
    (255.wrapping_sub(n), _) //~ error: L0230 cannot show `5 <= 255.wrapping_sub(n)`
}
