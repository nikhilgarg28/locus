// A definition is opened only by `unfold!` and closed only by `fold!`: a
// hole does not unfold `within_limit` on its own. `small` is evidence of
// the body, and `fold!(within_limit, small)` is the evidence of the call;
// the diagnostic names the form each way.
#[terminates] #[no_panic] #[no_io] logic fn within_limit(n: Int) -> Prop {
    prop!(n <= 3)
}

fn bounded(n: u8, small: @(n <= 3)) -> @within_limit(n) {
    _ //~ error: L0230 cannot show `within_limit(n)`
}

fn opened(n: u8, bounded: @within_limit(n)) -> @(n <= 3) {
    _ //~ error: L0230 cannot show `n <= 3`
}
