// Programs the elaborator lets through to the kernel, which rejects them: an
// `if` whose branches are evidence, and a `continue` that does not end a
// block. Each is a gap in the elaborator's own checks, reported as such.
fn choose(flag: bool) -> @(1 == 1) { //~ error: L0299 the checker rejected this
    if flag { _ } else { _ }
}

fn count(n: u8) -> u8 {
    let mut total: u8 = 0;
    for i in 0..n {
        let _ = continue; //~ error: L0299 break and continue may only end a block
        total = total.wrapping_add(i);
    }
    total
}
