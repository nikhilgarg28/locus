// Evidence of one claim passed where a stronger one is needed.
fn remaining(failures: u8, bounded: @[failures <= 3]) -> u8 {
    3.wrapping_sub(failures)
}

fn first(failures: u8, small: @[failures <= 9]) -> u8 {
    remaining(failures, small) //~ error: L0230 this is evidence of `failures <= 9`, and `failures <= 3` is needed
}
