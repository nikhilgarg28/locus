// Effects cannot enter an explicit logical block, even if its result erases.
fn may_loop(n: u8) -> u8 { n }
#[terminates] #[no_panic] #[no_io]
fn promised(n: u8) -> u8 { n }
fn in_logic(n: u8) -> Int {
    logic { may_loop(n) as Int } //~ error: L0209 ordinary fn `may_loop` cannot appear in a logic block
}
fn in_formula(n: u8) -> Prop {
    prop!(promised(n) == n) //~ error: L0209 ordinary fn `promised` cannot appear in a proposition
}
// Classification belongs to the type, not a binding qualifier.
fn cannot_extract(n: u8) -> u8 {
    let observed: Int = n as Int;
    observed as u8 //~ error: L0272 logical data cannot be converted into a runtime value
}
fn old_binding(n: u8) -> u8 {
    let old: Ghost<u8> = n; //~ error: L0271 Ghost<T> has been replaced by a logical model type
    n
}
fn old_snapshot(n: u8) -> Int {
    snapshot!(n) //~ error: L0271 snapshot! has been replaced by a model observation
}
