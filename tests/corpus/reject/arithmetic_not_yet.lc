// The arithmetic operators, unary minus, and `as` parse with Rust's
// precedence; the elaborator says which commit gives each its meaning.
fn add(a: u8, b: u8) -> u8 {
    a + b //~ error: L0290 the `+` operator is not in Locus yet
}

fn subtract(a: u8, b: u8) -> u8 {
    a - b //~ error: L0290 the `-` operator is not in Locus yet
}

fn multiply(a: u8, b: u8) -> u8 {
    a * b //~ error: L0290 the `*` operator is not in Locus yet
}

fn divide(a: u8, b: u8) -> u8 {
    a / b //~ error: L0290 the `/` operator is not in Locus yet
}

fn remainder(a: u8, b: u8) -> u8 {
    a % b //~ error: L0290 the `%` operator is not in Locus yet
}

fn negate(a: u8) -> u8 {
    -a //~ error: L0290 unary `-` is not in Locus yet
}

fn cast(a: u8) -> u8 {
    a as u8 //~ error: L0290 `as` is not in Locus yet
}

fn in_a_formula(a: u8, b: u8) -> u8 {
    prove!(a + b <= 255); //~ error: L0290 the `+` operator is not in Locus yet
    a
}

fn as_a_formula(a: u8, b: u8) -> Prop {
    prop!(a * b) //~ error: L0290 the `*` operator is not in Locus yet
}
