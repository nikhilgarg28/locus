// Case 10 of the mutation design, the half that must fail: the arms assign
// `x` and prove the bound, but nothing carries the evidence out of the
// branch, so after the join nothing is known of `x`. Evidence is a
// snapshot until M4 tracks it; `assign_join_evidence.lc` carries it out as
// the branch's value.
fn clamp(n: u8) -> u8 {
    let mut x = n;
    if x < 2 {
        x = 1;
        prove!(x <= 2);
    } else {
        x = 2;
        prove!(x <= 2);
    }
    prove!(x <= 2); //~ error: L0230 cannot show `x <= 2`
    x
}
