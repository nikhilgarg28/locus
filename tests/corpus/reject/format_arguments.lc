// A message is a string literal, written as it is: Rust's format arguments
// are not in Locus yet, and braces in a message mean nothing.
fn formatted(n: u8) -> u8 {
    panic!("n is {}", n) //~ error: L0290 format arguments are not in Locus yet
}

fn asserted(n: u8) -> u8 {
    assert!(n <= 3, "n is {}, at most 3", n); //~ error: L0290 format arguments are not in Locus yet
    n
}
//~ spec: 1.10:1
