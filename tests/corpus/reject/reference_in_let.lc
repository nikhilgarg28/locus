// Stored shared references require a borrow expression rather than a bare
// referent value. Mutable references still last for one call.
struct Holder {
    inner: &u8,
}

fn longest(a: &u8, b: &u8) -> &u8 {
    a //~ error: L0272 logical and runtime positions
}

fn kept(n: u8) -> u8 {
    let r: &u8 = n; //~ error: L0272 logical and runtime positions
    n
}

fn nested(n: &&mut u8) -> u8 { //~ error: L0285 stored mutable references are not supported; lend &mut for one call
    n
}

fn rebound(mut n: &mut u8) -> u8 { //~ error: L0260 `mut n` is not written on a reference parameter
    n
}
//~ spec: 1.13:1
