// Runtime promises never make an ordinary fn a logical definition.
#[terminates] #[no_panic] #[no_io]
fn gap(hi: u8, lo: u8, ordered: @(lo <= hi)) -> u8 {
    hi - lo
}

fn about_gap(hi: u8, lo: u8, ordered: @(lo <= hi)) -> @(gap(hi, lo, ordered) <= hi) { //~ error: L0209 ordinary fn `gap` cannot appear in a proposition
    _
}

// Evidence about `gap` cannot be stated either, so `unfold!` and `fold!`
// have nothing to work on: the proposition in the parameter is refused
// first, by the same rule.
fn opened(hi: u8, lo: u8, ordered: @(lo <= hi), h: @(gap(hi, lo, ordered) == 0)) -> @(hi == lo) { //~ error: L0209 ordinary fn `gap` cannot appear in a proposition
    unfold!(gap, h)
}

// A caller with the same promises and no operator of its own is not a
// term either, for the call: it is checked as an ordinary function too,
// and the same rule applies to it.
#[terminates] #[no_panic] #[no_io]
fn twice_the_gap(hi: u8, lo: u8, ordered: @(lo <= hi), room: @(hi as Int <= 100)) -> u8 {
    let d = gap(hi, lo, ordered);
    d
}

fn about_twice(hi: u8, lo: u8, ordered: @(lo <= hi), room: @(hi as Int <= 100)) -> Prop {
    prop!(twice_the_gap(hi, lo, ordered, room) <= 200) //~ error: L0209 ordinary fn `twice_the_gap` cannot appear in a proposition
}
