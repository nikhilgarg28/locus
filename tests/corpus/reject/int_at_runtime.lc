// `Int` is the integers of the logic and has no runtime form: it is a type
// in a claim, a function of the logic, and a proof type, and nowhere a value
// runs. A `let` of type `Int` is the exception, since it never runs either:
// its value is a logic-only context (E8, `ghost_values.lc`).
fn parameter(n: Int) -> u8 { //~ error: L0201 `Int` has no runtime form
    0
}

fn result(n: u8) -> Int { //~ error: L0201 `Int` has no runtime form
    n as Int
}

// `x as Int` speaks of `x` in a claim; outside one it names `Int` where a
// value runs, and so does the `Int as u8` that would bring it back.
fn back_again(n: u8) -> u8 {
    (n as Int) as u8 //~ error: L0201 `Int` has no runtime form
}

#[terminates] #[no_panic] #[no_io] fn fine(n: u8) -> Int {
    n as Int
}
