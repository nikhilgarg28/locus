// Logical values can pass through ordinary functions but cannot become data.
fn parameter(n: Int) -> u8 { 0 }
fn result(n: u8) -> Int { n as Int }
fn back_again(n: u8) -> u8 {
    (n as Int) as u8 //~ error: L0272 logical data cannot be converted into a runtime value
}
fn condition(n: Int) -> u8 {
    if n > 0 { 1 } else { 0 } //~ error: L0272 a runtime if requires bool; logical Bool cannot choose runtime behavior
}
