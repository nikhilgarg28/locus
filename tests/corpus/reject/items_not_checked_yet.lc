// S4 parses impl blocks; what gives them meaning comes later, and the
// elaborator says which commit. `derive` has its meaning since O1, and the
// promises have theirs:
// `#![no_io]` and the two on `get` admit it to a proposition.
#![no_io]
#[derive(Clone, Copy)]
pub struct Counter {
    pub count: u8,
}

#[terminates] #[no_panic]
pub(crate) fn get(counter: Counter) -> u8 { counter.count }

impl Counter { //~ error: L0290 `impl Counter` is parsed but not checked yet; O4
    pub fn new(count: u8) -> Self { Self { count } }
    fn read(&self) -> u8 { self.count }
}
