// A signed mathematical integer defined in ordinary library code. Native Int
// remains the compact arithmetic backend; model links this fragment to it.
#[derive(Logical)]
pub enum LibraryInt { NonNegative(Peano), Negative(Peano) }

pub logic fn integer_model(value: LibraryInt) -> Int {
    match value {
        LibraryInt::NonNegative(n) => nat_to_int(n),
        LibraryInt::Negative(n) => -(nat_to_int(n) + 1),
    }
}

pub logic fn integer_negate(value: LibraryInt) -> LibraryInt {
    match value {
        LibraryInt::NonNegative(n) => match n {
            Peano::Zero => LibraryInt::NonNegative(Peano::Zero),
            Peano::Succ(previous) => LibraryInt::Negative(previous),
        },
        LibraryInt::Negative(n) => LibraryInt::NonNegative(Peano::Succ(n)),
    }
}

pub logic fn integer_nonnegative_roundtrip(n: Int, nonnegative: @(n >= 0))
    -> @(integer_model(LibraryInt::NonNegative(nat_from_int(n))) == n)
{
    let exact = nat_to_from_int(n, nonnegative);
    fold!(integer_model, exact)
}

pub logic fn integer_negative_model(n: Peano)
    -> @(integer_model(LibraryInt::Negative(n)) == -(nat_to_int(n) + 1))
{
    fold!(integer_model, prove!(-(nat_to_int(n) + 1) == -(nat_to_int(n) + 1)))
}
