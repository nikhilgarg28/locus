// Explicit `logic fn` definitions may appear in propositions. Ordinary
// functions may transport evidence while retaining their runtime effects.
logic fn positive(n: Int) -> Prop {
    prop!(n > 0)
}

logic fn outside_range(n: Int) -> Prop {
    let above_zero: Prop = prop!(n > 0);
    let below_ten: Prop = prop!(n < 10);
    let inside = above_zero && below_ten;
    !inside
}

logic fn either(p: Prop, q: Prop) -> Prop {
    p || q
}

logic fn implies(p: Prop, q: Prop) -> Prop {
    prop!(p => q)
}

#[terminates] #[no_panic] #[no_io]
fn keep(p: Prop, evidence: @p) -> @p {
    evidence
}

// Both the returned claim and its evidence are logical values.
#[terminates] #[no_panic] #[no_io]
fn reflexivity_claim(n: u8) -> (claim: Prop, @claim) {
    let claim: Prop = prop!(n == n);
    (claim, _)
}

// A declared proposition lists the only ways it can be proved.
prop Small(n: Int) {
    Zero => { prop!(n == 0) }
    Below { limit: Int } => { prop!(n < limit && limit <= 10) }
}

logic fn small_is_below_ten(n: Int, small: @Small(n)) -> @(n < 10) {
    match small {
        Small::Zero @ zero => prove!(n < 10),
        Small::Below { limit } @ bound => {
            match bound { And::Intro(lower, upper) => prove!(n < 10) }
        },
    }
}

logic fn five_is_small() -> @Small(5) {
    Small::Below { limit: 10 } @ And::Intro(prove!(5 < 10), prove!(10 <= 10))
}

