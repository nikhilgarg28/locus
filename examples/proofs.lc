#[terminates] #[no_panic] #[no_io]
logic fn same(x: Int, y: Int) -> Prop {
    prop!(x == y)
}

const equality_is_reflexive: Prop = prop!(
    forall (n: Int) { n == n }
);

const equality_is_transitive: Prop = prop!(
    forall (x: Int, y: Int, z: Int) {
        same(x, y) && same(y, z) => same(x, z)
    }
);

const some_integer_is_zero: Prop = prop!(
    exists (n: Int) { n == 0 }
);

// Evidence is an ordinary expression. `unfold!` opens the definition, and
// `rewrite!` carries a claim across the equation it gave: every `x` in the
// claim becomes `y`. The left side is named first so that it stays; a name
// bound by `let` is replaced by what it stands for only when computing,
// which is how the result is the claim as stated.
#[terminates] #[no_panic] #[no_io]
fn increment_preserves_equality(
    x: u8,
    y: u8,
    equal: @same(x, y),
) -> @(x.wrapping_add(1) == y.wrapping_add(1)) {
    let plain: @(x == y) = unfold!(same, equal);
    let next = x.wrapping_add(1);
    rewrite!(plain, prove!(next == x.wrapping_add(1)))
}

#[terminates] #[no_panic] #[no_io]
fn self_equal(n: u8) -> @(n == n) {
    let claim: Prop = prop!(n == n);
    let evidence: @claim = _;
    evidence
}

// A call returning Prop can be used directly as a proof type's target. The
// definition is closed over evidence of its body, which holds by computing:
// `out` is what it was bound to, and the equation is reflexive.
fn increment(n: u8) -> (out: u8, @same(out, n.wrapping_add(1))) {
    let out = n.wrapping_add(1);
    (out, fold!(same, prove!(out == n.wrapping_add(1))))
}

// Only `increment` exists at runtime; the rest of the file is logic.
//~ proofs: 5
//~ run: increment(9) => (10, Erased)
//~ spec: 1.7:3
