// A lock that tolerates three wrong codes. The failure count never exceeds
// the limit, and every function that hands the count on says so with evidence.

enum Event {
    Wrong,
    Right,
}

struct Lock {
    failures: u8,
    open: bool,
}

#[terminates] #[no_panic] #[no_io]
fn within_limit(failures: u8) -> Prop {
    prop!(failures <= 3)
}

// One transition. The caller proves the bound once; the result carries it on.
// Evidence is stated where it is not already in scope: `fold!` closes the
// definition of `within_limit` over evidence of its body, and a lemma call
// takes the step from `lock.failures < 3` to a bound on the successor.
fn step(
    lock: Lock,
    bounded: @within_limit(lock.failures),
    event: Event,
) -> (next: Lock, @within_limit(next.failures)) {
    match event {
        Event::Right => (Lock { failures: 0, open: true }, fold!(within_limit, prove!(0u8 <= 3))),
        Event::Wrong => {
            if lock.failures < 3 {
                let fits = u8_succ_le_of_lt(lock.failures, 3, prove!(lock.failures < 3));
                (Lock { failures: lock.failures.wrapping_add(1), open: false }, fold!(within_limit, fits))
            } else {
                (Lock { failures: lock.failures, open: false }, bounded)
            }
        }
    }
}

// The code is right on the attempt numbered `correct`, and wrong otherwise.
fn event_at(attempt: u8, correct: u8) -> Event {
    if attempt == correct { Event::Right } else { Event::Wrong }
}

// The invariant travels beside the lock it describes: the loop assigns one
// value that holds both, and `step` returns exactly that value, typed over
// the lock it hands back. (Tracked evidence, `let mut bounded: @...`,
// refreshed in the body, is M4's; then the two travel as two variables.)
fn run(attempts: u8, correct: u8) -> (last: Lock, @within_limit(last.failures)) {
    let mut state: (lock: Lock, @within_limit(lock.failures)) =
        (Lock { failures: 0, open: false }, fold!(within_limit, prove!(0u8 <= 3)));
    for attempt in 0..attempts {
        let (lock, bounded) = state;
        state = step(lock, bounded, event_at(attempt, correct));
    }
    state
}

// Needs the bound: without it the subtraction could wrap. `unfold!` opens
// the definition, and the lemma says a difference under the bound stays
// under it.
fn remaining(failures: u8, bounded: @within_limit(failures)) -> (left: u8, @(left <= 3)) {
    (3.wrapping_sub(failures), u8_sub_le(3, failures, unfold!(within_limit, bounded)))
}

// The caller reuses the evidence `run` returned; nothing is proved twice.
fn attempts_left(attempts: u8, correct: u8) -> u8 {
    let (last, bounded) = run(attempts, correct);
    let (left, _) = remaining(last.failures, bounded);
    left
}

