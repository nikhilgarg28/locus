def same(x: Nat, y: Nat) -> Prop {
    [x == y]
}

const equality_is_reflexive: Prop = [
    forall (n: Nat) { n == n }
];

const equality_is_transitive: Prop = [
    forall (x: Nat, y: Nat, z: Nat) {
        same(x, y) && same(y, z) => same(x, z)
    }
];

fn increment_preserves_equality(
    x: Nat,
    y: Nat,
    equal: @same(x, y),
) -> @[x + 1 == y + 1] {
    @{
        rewrite equal;
        reflexivity;
    }
}

fn self_equal(n: Nat) -> @[n == n] {
    let claim: Prop = [n == n];
    let evidence: @claim = _;
    evidence
}

// A call returning Prop can be used directly as a proof type's target.
fn increment(n: Nat) -> (out: Nat, @same(out, n + 1)) {
    let out = n + 1;
    (out, _)
}
